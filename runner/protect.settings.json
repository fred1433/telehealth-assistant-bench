        "~/Library",
        "~/Documents",
        "~/Desktop",
        "~/Downloads",
        "~/.config",
        "~/.claude",
        "~/.hermes",
        "~/.local",
        "~/.aws",
        "~/.gnupg",
        "~/.npmrc",
        "/private/tmp/thb-adaptive/done",
        "/private/tmp/thb-adaptive/grade",
        "/private/tmp/thb-adaptive/results",
        "/private/tmp/thb-adaptive/controls",
        "/private/tmp/thb-adaptive/base"
      ]
    }
  }
}