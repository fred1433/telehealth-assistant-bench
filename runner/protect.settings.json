{
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(//Users/**)",
      "Edit(//Users/**)",
      "Read(//private/tmp/claude-501/-Users-*/**)",
      "Edit(//private/tmp/claude-501/-Users-*/**)",
      "Read(//private/tmp/thb-adaptive/done/**)",
      "Read(//private/tmp/thb-adaptive/grade/**)",
      "Read(//private/tmp/thb-adaptive/results/**)",
      "Read(//private/tmp/thb-adaptive/controls/**)",
      "Read(//private/tmp/thb-adaptive/base/**)",
      "Edit(//private/tmp/thb-adaptive/done/**)",
      "Edit(//private/tmp/thb-adaptive/grade/**)",
      "Edit(//private/tmp/thb-adaptive/results/**)",
      "Edit(//private/tmp/thb-adaptive/controls/**)",
      "Edit(//private/tmp/thb-adaptive/base/**)",
      "WebFetch",
      "WebSearch"
