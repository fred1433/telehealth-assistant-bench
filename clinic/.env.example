# Local development. Copy to .env.local and adjust.
DATABASE_URL=mysql://clinic:clinic@127.0.0.1:3306/clinic
REDIS_URL=redis://127.0.0.1:6379/0
APP_BASE_URL=http://localhost:3000
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=no-reply@clinic.example
PUSH_TRANSPORT=fcm
FCM_ENDPOINT=http://127.0.0.1:9099
FCM_PROJECT=clinic-dev
FCM_ACCESS_TOKEN=dev-token
LOG_FILE=logs/app.log
# Tests read TEST_DATABASE_URL / TEST_REDIS_URL (see tests/setup-env.ts).
