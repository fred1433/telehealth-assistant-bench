+++ b/src/lib/notify.ts
@@ -0,0 +1,31 @@
+import { env } from './env';
+import { logger } from './logger';
+import { sendMail } from './mailer';
+import { sendPush } from './push';
+import { listPushTokens } from '@/repos/devices';
+
+/**
+ * Tells a user a secure message is waiting. Content is deliberately generic (no PHI).
+ * Never throws; failures are logged with ids only.
+ */
+export async function notifyNewSecureMessage(recipient: { id: string; email: string }, messageId: string): Promise<void> {
+  const text = `You have a new secure message waiting. Please sign in to read it: ${env.appBaseUrl}`;
+  const tasks: Promise<void>[] = [
+    sendMail({ to: recipient.email, subject: 'You have a new secure message', text }),
+  ];
+  try {
+    for (const token of await listPushTokens(recipient.id)) {
+      tasks.push(
+        sendPush({
+          token,
+          notification: { title: 'New secure message', body: 'You have a new secure message. Sign in to read it.' },
+        }),
+      );
+    }
+  } catch {
+    logger.warn('push token lookup failed', { messageId, recipientId: recipient.id });
+  }
+  const results = await Promise.allSettled(tasks);
+  const failed = results.filter((r) => r.status === 'rejected').length;
+  if (failed > 0) logger.warn('message notification failed', { messageId, recipientId: recipient.id, failed });
+}
