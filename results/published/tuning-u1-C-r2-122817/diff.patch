+
+export interface CancelContext {
+  id: string;
+  org_id: string;
+  patient_id: string;
+  practitioner_id: string;
+  status: 'booked' | 'cancelled' | 'completed';
+  patient_email: string | null;
+  practitioner_email: string;
+}
+
+/** Narrow lookup for cancelling: ids, status and the two contact emails only. */
+export async function getCancelContext(id: string): Promise<CancelContext | null> {
+  return queryOne<CancelContext>(
+    `SELECT a.id, a.org_id, a.patient_id, a.practitioner_id, a.status,
+            COALESCE(pu.email, p.email) AS patient_email, pru.email AS practitioner_email
+       FROM appointments a
+       JOIN patients p ON p.id = a.patient_id
+       JOIN practitioners pr ON pr.id = a.practitioner_id
+       JOIN users pru ON pru.id = pr.user_id
+       LEFT JOIN users pu ON pu.id = p.user_id
+      WHERE a.id = ?`,
+    [id],
+  );
+}
+
+/** Marks a booked appointment cancelled. Returns false if it was not in 'booked' status. */
+export async function cancelBooked(id: string): Promise<boolean> {
+  const res = await execute("UPDATE appointments SET status = 'cancelled' WHERE id = ? AND status = 'booked'", [id]);
+  return res.affectedRows > 0;
+}
