+import { describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/appointments/[id]/cancel/route';
+import { mailOutbox } from '@/lib/mailer';
+import { query } from '@/lib/db';
+import { call, TOKENS } from './helpers';
+
+const cancel = (id: string, token?: string) =>
+  call(POST, { method: 'POST', path: `/api/appointments/${id}/cancel`, token, params: { id } });
+const statusOf = async (id: string) =>
+  (await query<{ status: string }>('SELECT status FROM appointments WHERE id = ?', [id]))[0].status;
+
+describe('POST /api/appointments/{id}/cancel', () => {
+  it('rejects unauthenticated callers', async () => {
+    expect((await cancel('apt_001')).status).toBe(401);
+  });
+
+  it('404s for other patients, other practitioners, other practice, admin, and unknown ids', async () => {
+    for (const token of [TOKENS.theo, TOKENS.malik, TOKENS.hal, TOKENS.june, TOKENS.dana]) {
+      const res = await cancel('apt_001', token);
+      expect(res.status).toBe(404);
+    }
+    expect((await cancel('apt_nope', TOKENS.ava)).status).toBe(404);
+    expect(await statusOf('apt_001')).toBe('booked');
+    expect(mailOutbox).toHaveLength(0);
+  });
+
+  it('patient cancels: practitioner gets a generic email, no PHI, no PHI in logs', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const errw = vi.spyOn(process.stderr, 'write');
+    const res = await cancel('apt_001', TOKENS.ava);
+    expect(res.status).toBe(200);
+    expect(res.json).toEqual({ id: 'apt_001', status: 'cancelled' });
+    expect(await statusOf('apt_001')).toBe('cancelled');
+    expect(mailOutbox).toHaveLength(1);
+    const mail = mailOutbox[0];
+    const blob = JSON.stringify(mail);
+    for (const s of ['Ava', 'sleep', 'anxiety', 'diary']) expect(blob).not.toContain(s);
+    const logged = [...out.mock.calls, ...errw.mock.calls].map((c) => String(c[0])).join('');
+    for (const s of ['Ava', 'sleep', 'ava@']) expect(logged).not.toContain(s);
+    vi.restoreAllMocks();
+  });
+
+  it('practitioner cancels: patient is emailed; second cancel is 409', async () => {
+    mailOutbox.length = 0;
+    const res = await cancel('apt_002', TOKENS.rosa);
+    expect(res.status).toBe(200);
+    expect(mailOutbox).toHaveLength(1);
+    const blob = JSON.stringify(mailOutbox[0]);
+    for (const s of ['Theo', 'Rosa', 'Relapse']) expect(blob).not.toContain(s);
+    expect((await cancel('apt_002', TOKENS.rosa)).status).toBe(409);
+    expect(mailOutbox).toHaveLength(1);
+  });
+});
