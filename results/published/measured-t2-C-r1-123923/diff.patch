+describe('GET /api/messages/{id}', () => {
+  it('lets the recipient read it, returns exactly the allowed fields and marks it read', async () => {
+    const res = await call(GET_ONE, { token: TOKENS.ava, params: { id: 'msg_001' } });
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.json).sort()).toEqual(['body', 'from', 'id', 'sentAt', 'subject']);
+    expect(res.json.from).toEqual({ name: expect.any(String) });
+    const row = await queryOne<{ read_at: Date | null }>('SELECT read_at FROM messages WHERE id = ?', ['msg_001']);
+    expect(row?.read_at).not.toBeNull();
+  });
+
+  it('404s for the sender, other patients, admin and other practice, without marking read', async () => {
+    const sender = await call(GET_ONE, { token: TOKENS.rosa, params: { id: 'msg_001' } });
+    expect(sender.status).toBe(404);
+    for (const token of [TOKENS.ava, TOKENS.theo, TOKENS.dana, TOKENS.hal, TOKENS.june]) {
+      const res = await call(GET_ONE, { token, params: { id: 'msg_002' } });
+      expect(res.status).toBe(404);
+      expect(res.json).toEqual({ error: 'not_found' });
+    }
+    const missing = await call(GET_ONE, { token: TOKENS.ava, params: { id: 'msg_nope' } });
+    expect(missing.status).toBe(404);
+    const row = await queryOne<{ read_at: Date | null }>('SELECT read_at FROM messages WHERE id = ?', ['msg_002']);
+    expect(row?.read_at).toBeNull();
+  });
+
+  it('requires authentication', async () => {
+    const res = await call(GET_ONE, { params: { id: 'msg_001' } });
+    expect(res.status).toBe(401);
+  });
+});
