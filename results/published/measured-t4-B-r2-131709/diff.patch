diff --git a/src/lib/dayViewCache.ts b/src/lib/dayViewCache.ts
new file mode 100644
index 0000000..ea7ff08
--- /dev/null
+++ b/src/lib/dayViewCache.ts
@@ -0,0 +1,53 @@
+import { getRedis, KEY_PREFIX } from './redis';
+import { logger } from './logger';
+
+/** Entries live one minute: bounded staleness for changes that do not invalidate (new/cancelled appointments). */
+const ENTRY_TTL_SECONDS = 60;
+/** Version counters outlive every entry they guard (max 15 min allowed). */
+const VERSION_TTL_SECONDS = 900;
+
+const versionKey = (practitionerId: string) => `${KEY_PREFIX}dayview:v:${practitionerId}`;
+const entryKey = (practitionerId: string, day: string, version: string) =>
+  `${KEY_PREFIX}dayview:${practitionerId}:${day}:${version}`;
+
+export interface DayViewCacheHandle {
+  get(): Promise<string | null>;
+  set(serialized: string): Promise<void>;
+}
+
+/** Cache handle for one practitioner's day. Keys hold practitioner id and date only, never a patient id. Fails open. */
+export async function openDayView(practitionerId: string, day: string): Promise<DayViewCacheHandle> {
+  let key: string | null = null;
+  try {
+    const version = (await getRedis().get(versionKey(practitionerId))) ?? '0';
+    key = entryKey(practitionerId, day, version);
+  } catch (err) {
+    logger.warn('dayview cache unavailable', { code: (err as { code?: string }).code });
+  }
+  return {
+    async get() {
+      if (!key) return null;
+      try {
+        return await getRedis().get(key);
+      } catch (err) {
+        logger.warn('dayview cache read failed', { code: (err as { code?: string }).code });
+        return null;
+      }
+    },
+    async set(serialized) {
+      if (!key) return;
+      try {
+        await getRedis().set(key, serialized, 'EX', ENTRY_TTL_SECONDS);
+      } catch (err) {
+        logger.warn('dayview cache write failed', { code: (err as { code?: string }).code });
+      }
+    },
+  };
+}
+
+/** Drops every cached day view of a practitioner (bumps the version so in-flight reads cannot repopulate it). */
+export async function invalidateDayView(practitionerId: string): Promise<void> {
+  const redis = getRedis();
+  await redis.incr(versionKey(practitionerId));
+  await redis.expire(versionKey(practitionerId), VERSION_TTL_SECONDS);
+}
diff --git a/tests/dayview-cache.test.ts b/tests/dayview-cache.test.ts
new file mode 100644
index 0000000..6d81b60
--- /dev/null
+++ b/tests/dayview-cache.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/practitioner/schedule/today/route';
+import { POST as REVOKE } from '@/app/api/admin/care-team/revoke/route';
+import { getRedis, KEY_PREFIX } from '@/lib/redis';
+import { call, TOKENS } from './helpers';
+
+const ids = (r: { json: any }) => r.json.appointments.map((a: { id: string }) => a.id);
+
+describe('day view cache', () => {
+  it('writes only short-lived keys without patient ids and no clinical content', async () => {
+    await call(GET, { token: TOKENS.rosa });
+    const redis = getRedis();
+    const keys = await redis.keys(`${KEY_PREFIX}dayview:*`);
+    expect(keys.length).toBeGreaterThan(0);
+    for (const k of keys) {
+      expect(k).not.toMatch(/pt_/);
+      const ttl = await redis.ttl(k);
+      expect(ttl).toBeGreaterThan(0);
+      expect(ttl).toBeLessThanOrEqual(900);
+      const v = (await redis.get(k)) ?? '';
+      expect(v).not.toContain('Follow-up on sleep');
+      expect(v).not.toContain('Bring sleep diary');
+    }
+  });
+
+  it('keeps practitioners separate', async () => {
+    const rosa = await call(GET, { token: TOKENS.rosa });
+    const malik = await call(GET, { token: TOKENS.malik });
+    expect(ids(rosa)).toEqual(['apt_001', 'apt_002']);
+    expect(ids(malik)).toEqual(['apt_003']);
+    expect(ids(await call(GET, { token: TOKENS.rosa }))).toEqual(['apt_001', 'apt_002']);
+  });
+
+  it('drops a patient from a cached day view right after revoke', async () => {
+    expect(ids(await call(GET, { token: TOKENS.rosa }))).toContain('apt_002');
+    const res = await call(REVOKE, {
+      method: 'POST',
+      token: TOKENS.dana,
+      body: { practitionerId: 'pr_rosa', patientId: 'pt_theo' },
+    });
+    expect(res.status).toBe(200);
+    expect(ids(await call(GET, { token: TOKENS.rosa }))).toEqual(['apt_001']);
+  });
+});
