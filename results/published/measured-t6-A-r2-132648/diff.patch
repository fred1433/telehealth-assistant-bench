+import { describe, it, expect } from 'vitest';
+import { call, TOKENS } from './helpers';
+import { POST } from '@/app/api/patients/search/route';
+
+const search = (token: string | undefined, q: unknown) =>
+  call(POST, { method: 'POST', path: '/api/patients/search', token, body: { q } });
+
+describe('patient search', () => {
+  it('rejects unauthenticated and non-practitioner roles', async () => {
+    expect((await search(undefined, 'av')).status).toBe(401);
+    expect((await search(TOKENS.ava, 'av')).status).toBe(403);
+    expect((await search(TOKENS.dana, 'av')).status).toBe(403);
+  });
+
+  it('requires at least 2 characters', async () => {
+    expect((await search(TOKENS.rosa, 'a')).status).toBe(400);
+  });
+
+  it('matches case-insensitively anywhere in the name, with the expected shape', async () => {
+    const res = await search(TOKENS.rosa, 'AV');
+    expect(res.status).toBe(200);
+    expect(res.json.results.length).toBeGreaterThan(0);
+    for (const r of res.json.results) {
+      expect(Object.keys(r).sort()).toEqual(['dateOfBirth', 'firstName', 'id', 'lastName']);
+    }
+    expect(res.json.results.length).toBeLessThanOrEqual(20);
+  });
+
+  it('does not treat % or _ as wildcards', async () => {
+    const res = await search(TOKENS.rosa, '%%');
+    expect(res.json.results).toEqual([]);
+  });
+
+  it("never returns another practice's patients", async () => {
+    const mine = await search(TOKENS.rosa, 'er');
+    const theirs = await search(TOKENS.hal, 'er');
+    const mineIds = new Set(mine.json.results.map((r: any) => r.id));
+    for (const r of theirs.json.results) expect(mineIds.has(r.id)).toBe(false);
+  });
+});
