+import { z } from 'zod';
+import { requireUser } from '@/lib/auth';
+import { json, readJson, route, HttpError } from '@/lib/http';
+import { searchPatientsByName } from '@/repos/patients';
+
+const Body = z.object({ q: z.string().trim().min(2).max(80) });
+
+/**
+ * Name search for practitioners. POST with a JSON body on purpose: the searched
+ * name must never appear in a URL/query string (the Apache access log records them).
+ */
+export const POST = route(async (req) => {
+  const user = await requireUser(req);
+  if (user.role !== 'practitioner') throw new HttpError(403, 'forbidden');
+  const { q } = Body.parse(await readJson(req));
+  const rows = await searchPatientsByName(user.orgId, q, 20);
+  return json({
+    results: rows.map((p) => ({
+      id: p.id,
+      firstName: p.first_name,
+      lastName: p.last_name,
+      dateOfBirth: p.date_of_birth,
+    })),
+  });
+});
