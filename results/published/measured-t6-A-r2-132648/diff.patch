 }
 
+export interface PatientSearchRow {
+  id: string;
+  first_name: string;
+  last_name: string;
+  date_of_birth: string;
+}
+
+/** Case-insensitive substring match on first/last name within one org (LIKE wildcards in the fragment are escaped). */
+export async function searchPatientsByName(orgId: string, fragment: string, limit = 20): Promise<PatientSearchRow[]> {
+  const pattern = `%${fragment.replace(/[\\%_]/g, '\\$&')}%`;
+  return query<PatientSearchRow>(
+    `SELECT id, first_name, last_name, DATE_FORMAT(date_of_birth, '%Y-%m-%d') AS date_of_birth
+       FROM patients
+      WHERE org_id = ? AND (first_name LIKE ? OR last_name LIKE ?)
+      ORDER BY last_name, first_name, id
+      LIMIT ?`,
+    [orgId, pattern, pattern, limit],
+  );
+}
+
 export async function getPatientByUserId(userId: string): Promise<PatientRow | null> {
   return queryOne<PatientRow>('SELECT * FROM patients WHERE user_id = ?', [userId]);
 }
