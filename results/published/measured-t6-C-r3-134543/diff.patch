+import { z } from 'zod';
+import { requireUser } from '@/lib/auth';
+import { json, readJson, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { searchByName } from '@/repos/patients';
+
+const Body = z.object({ q: z.string().trim().min(2).max(80) });
+
+/** Patient search for practitioners. POST so the searched name stays out of the URL (Apache logs it). */
+export const POST = route(async (req) => {
+  const user = await requireUser(req);
+  if (user.role !== 'practitioner' || !user.practitionerId) throw new HttpError(403, 'forbidden');
+  const { q } = Body.parse(await readJson(req));
+  const rows = await searchByName(user.orgId, q, 20);
+  await audit(user, 'patients.search', 'org', user.orgId);
+  return json({
+    results: rows.map((p) => ({
+      id: p.id,
+      firstName: p.first_name,
+      lastName: p.last_name,
+      dateOfBirth: p.date_of_birth,
+    })),
+  });
+});
