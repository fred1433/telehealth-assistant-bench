+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/patients/search/route';
+import { call, TOKENS } from './helpers';
+
+const search = (token: string | undefined, q: unknown) =>
+  call(POST, { method: 'POST', path: '/api/patients/search', token, body: { q } });
+
+describe('POST /api/patients/search', () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it('matches case-insensitively anywhere in first or last name, own practice only', async () => {
+    const res = await search(TOKENS.rosa, 'LIND');
+    expect(res.status).toBe(200);
+    expect(res.json.results).toEqual([
+      { id: 'pt_ava', firstName: 'Ava', lastName: 'Lindqvist', dateOfBirth: expect.any(String) },
+    ]);
+    const byFirst = await search(TOKENS.malik, 'ri');
+    expect(byFirst.json.results.map((r: { id: string }) => r.id).sort()).toEqual(['pt_priya']);
+  });
+
+  it('does not return exact response fields beyond the four, nor other-practice patients', async () => {
+    const res = await search(TOKENS.rosa, 'in');
+    expect(res.text).not.toContain('June');
+    expect(res.text).not.toContain('mail.example');
+    expect(res.text).not.toContain('JH-000');
+    expect(res.text).not.toContain('anxiety');
+  });
+
+  it('treats % and _ literally', async () => {
+    const res = await search(TOKENS.rosa, '%%');
+    expect(res.json.results).toEqual([]);
+  });
+
+  it('rejects short or missing q with 400', async () => {
+    expect((await search(TOKENS.rosa, 'a')).status).toBe(400);
+    expect((await search(TOKENS.rosa, undefined)).status).toBe(400);
+  });
+
+  it('403 for other roles, 401 unauthenticated', async () => {
+    expect((await search(TOKENS.ava, 'ava')).status).toBe(403);
+    expect((await search(TOKENS.dana, 'ava')).status).toBe(403);
+    expect((await search(undefined, 'ava')).status).toBe(401);
+  });
+
+  it('other practice practitioner sees only own patients', async () => {
+    const res = await search(TOKENS.hal, 'lind');
+    expect(res.json.results.map((r: { id: string }) => r.id)).toEqual(['pt_june']);
+  });
+
+  it('writes nothing identifying to logs', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    await search(TOKENS.rosa, 'Lindqvist');
+    const all = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    expect(all).not.toContain('Lindqvist');
+  });
+});
