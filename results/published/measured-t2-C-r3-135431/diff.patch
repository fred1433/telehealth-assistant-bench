@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/messages/[id]/route';
+import { queryOne } from '@/lib/db';
+import { call, TOKENS } from './helpers';
+
+const get = (id: string, token?: string) => call(GET, { token, path: `/api/messages/${id}`, params: { id } });
+
+describe('GET /api/messages/{id}', () => {
+  it('requires authentication', async () => {
+    expect((await get('msg_001')).status).toBe(401);
+  });
+
+  it('hides the message from non-recipients, admins and other practices', async () => {
+    for (const t of [TOKENS.rosa, TOKENS.theo, TOKENS.dana, TOKENS.hal, TOKENS.june]) {
+      const res = await get('msg_001', t);
+      expect(res.status).toBe(404);
+      expect(res.text).not.toContain('sleep diary');
+    }
+    const row = await queryOne<{ read_at: Date | null }>('SELECT read_at FROM messages WHERE id = ?', ['msg_001']);
+    expect(row?.read_at).toBeNull();
+  });
+
+  it('404s for an unknown id', async () => {
+    expect((await get('msg_nope', TOKENS.ava)).status).toBe(404);
+  });
+
+  it('returns exactly the allowed fields to the recipient and marks it read', async () => {
+    const res = await get('msg_001', TOKENS.ava);
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.json).sort()).toEqual(['body', 'from', 'id', 'sentAt', 'subject']);
+    expect(Object.keys(res.json.from)).toEqual(['name']);
+    expect(res.json.id).toBe('msg_001');
+    const row = await queryOne<{ read_at: Date | null }>('SELECT read_at FROM messages WHERE id = ?', ['msg_001']);
+    expect(row?.read_at).not.toBeNull();
+  });
+});
