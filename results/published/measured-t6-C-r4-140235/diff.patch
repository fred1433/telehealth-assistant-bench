+import { z } from 'zod';
+import { requireUser, requireRole } from '@/lib/auth';
+import { json, readJson, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { searchForPractitioner } from '@/repos/patients';
+
+// The name fragment travels in the POST body, never in the URL (Apache logs request lines).
+const Body = z.object({ q: z.string().trim().min(2).max(80) });
+
+export const POST = route(async (req) => {
+  const user = await requireUser(req);
+  requireRole(user, 'practitioner');
+  if (!user.practitionerId) throw new HttpError(403, 'forbidden');
+  const { q } = Body.parse(await readJson(req));
+  const hits = await searchForPractitioner(user.orgId, user.practitionerId, q);
+  await audit(user, 'patients.search', 'practitioner', user.practitionerId);
+  return json({
+    results: hits.map((h) => ({
+      id: h.id,
+      firstName: h.first_name,
+      lastName: h.last_name,
+      dateOfBirth: h.date_of_birth,
+    })),
+  });
+});
