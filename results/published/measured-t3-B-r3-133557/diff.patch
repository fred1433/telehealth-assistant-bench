+/** Every message the user sent or received, for the owner's own export. No counterpart details. */
+export async function listExportForUser(userId: string): Promise<Array<{ id: string; subject: string; body: string; created_at: Date; direction: 'sent' | 'received' }>> {
+  return query(
+    `SELECT id, subject, body, created_at,
+            IF(sender_user_id = ?, 'sent', 'received') AS direction
+       FROM messages
+      WHERE sender_user_id = ? OR recipient_user_id = ?
+      ORDER BY created_at, id`,
+    [userId, userId, userId],
+  );
+}
