diff --git a/src/lib/scheduleCache.ts b/src/lib/scheduleCache.ts
new file mode 100644
index 0000000..5f2bf96
--- /dev/null
+++ b/src/lib/scheduleCache.ts
@@ -0,0 +1,41 @@
+import { getRedis, KEY_PREFIX } from './redis';
+import { logger } from './logger';
+
+/**
+ * Short-lived cache of a practitioner's day view. The value is the response body, which
+ * holds patient names (PHI), so the TTL is short and the key is scoped to one practitioner.
+ * The key holds only the practitioner id and the day, never a patient identifier.
+ */
+const TTL_SECONDS = 60;
+
+const key = (practitionerId: string, day: string) => `${KEY_PREFIX}schedule:today:${practitionerId}:${day}`;
+const keyPattern = (practitionerId: string) => `${KEY_PREFIX}schedule:today:${practitionerId}:*`;
+
+export async function getCachedDay<T>(practitionerId: string, day: string): Promise<T | null> {
+  try {
+    const raw = await getRedis().get(key(practitionerId, day));
+    return raw ? (JSON.parse(raw) as T) : null;
+  } catch (err) {
+    logger.warn('schedule_cache_read_failed', { code: (err as { code?: string }).code });
+    return null;
+  }
+}
+
+export async function setCachedDay(practitionerId: string, day: string, value: unknown): Promise<void> {
+  try {
+    await getRedis().set(key(practitionerId, day), JSON.stringify(value), 'EX', TTL_SECONDS);
+  } catch (err) {
+    logger.warn('schedule_cache_write_failed', { code: (err as { code?: string }).code });
+  }
+}
+
+/** Drops every cached day view of one practitioner. Throws on failure so callers can decide. */
+export async function invalidateDays(practitionerId: string): Promise<void> {
+  const redis = getRedis();
+  let cursor = '0';
+  do {
+    const [next, keys] = await redis.scan(cursor, 'MATCH', keyPattern(practitionerId), 'COUNT', 100);
+    cursor = next;
+    if (keys.length) await redis.del(...keys);
+  } while (cursor !== '0');
+}
diff --git a/tests/scheduleCache.test.ts b/tests/scheduleCache.test.ts
new file mode 100644
index 0000000..d62cb66
--- /dev/null
+++ b/tests/scheduleCache.test.ts
@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/practitioner/schedule/today/route';
+import { POST as REVOKE } from '@/app/api/admin/care-team/revoke/route';
+import { getRedis } from '@/lib/redis';
+import { call, TOKENS } from './helpers';
+
+const ids = (r: { json: any }) => r.json.appointments.map((a: { id: string }) => a.id);
+
+describe('day view cache', () => {
+  it('stores keys without patient ids, with a TTL of at most 15 minutes, and no clinical content', async () => {
+    const first = await call(GET, { token: TOKENS.rosa });
+    const second = await call(GET, { token: TOKENS.rosa });
+    expect(second.json).toEqual(first.json);
+
+    const redis = getRedis();
+    const keys = await redis.keys('clinic:schedule:*');
+    expect(keys.length).toBe(1);
+    for (const k of keys) {
+      expect(k).not.toMatch(/pt_/);
+      const ttl = await redis.ttl(k);
+      expect(ttl).toBeGreaterThan(0);
+      expect(ttl).toBeLessThanOrEqual(900);
+      const value = (await redis.get(k)) ?? '';
+      expect(value).not.toContain('Follow-up on sleep');
+      expect(value).not.toContain('Bring sleep diary');
+      expect(value).not.toContain('visit_reason');
+      expect(value).not.toContain('notes');
+    }
+    for (const k of await redis.keys('*')) expect(await redis.ttl(k)).not.toBe(-1);
+  });
+
+  it("keeps practitioners' days apart", async () => {
+    await call(GET, { token: TOKENS.rosa });
+    const malik = await call(GET, { token: TOKENS.malik });
+    expect(ids(malik)).toEqual(['apt_003']);
+    expect(ids(await call(GET, { token: TOKENS.rosa }))).toEqual(['apt_001', 'apt_002']);
+  });
+
+  it('drops a patient from the cached day view as soon as access is revoked', async () => {
+    expect(ids(await call(GET, { token: TOKENS.rosa }))).toContain('apt_002');
+    const res = await call(REVOKE, { method: 'POST', token: TOKENS.dana, body: { practitionerId: 'pr_rosa', patientId: 'pt_theo' } });
+    expect(res.status).toBe(200);
+    expect(ids(await call(GET, { token: TOKENS.rosa }))).toEqual(['apt_001']);
+  });
+});
