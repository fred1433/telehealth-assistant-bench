+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { logger } from '@/lib/logger';
+import { sendMail } from '@/lib/mailer';
+import { env } from '@/lib/env';
+import { hasActiveAccess } from '@/repos/careTeam';
+import { cancelBooked, getPatientEmail, getPractitionerEmail, getRef } from '@/repos/appointments';
+
+type Ctx = { params: Promise<{ id: string }> };
+
+export const POST = route<Ctx>(async (req, { params }) => {
+  const user = await requireUser(req);
+  const { id } = await params;
+
+  const appt = await getRef(id);
+  if (!appt || appt.org_id !== user.orgId) throw new HttpError(404, 'not_found');
+
+  const byPatient = user.role === 'patient' && !!user.patientId && user.patientId === appt.patient_id;
+  const byPractitioner =
+    user.role === 'practitioner' &&
+    !!user.practitionerId &&
+    user.practitionerId === appt.practitioner_id &&
+    (await hasActiveAccess(appt.practitioner_id, appt.patient_id));
+  if (!byPatient && !byPractitioner) throw new HttpError(404, 'not_found');
+
+  if (!(await cancelBooked(appt.id))) throw new HttpError(409, 'not_cancellable');
+  await audit(user, 'appointment.cancel', 'appointment', appt.id);
+
+  try {
+    const to = byPatient ? await getPractitionerEmail(appt.practitioner_id) : await getPatientEmail(appt.patient_id);
+    if (to) {
+      await sendMail({
+        to,
+        subject: 'An appointment was cancelled',
+        text: `An appointment was cancelled. Details are in the portal: ${env.appBaseUrl}`,
+      });
+    }
+  } catch (err) {
+    // The cancellation stands; only the notification failed.
+    logger.error('appointment cancel notification failed', {
+      appointmentId: appt.id,
+      code: (err as { code?: string }).code,
+    });
+  }
+
+  return json({ id: appt.id, status: 'cancelled' });
+});
