@@ -0,0 +1,58 @@
+import { describe, expect, it } from 'vitest';
+import { POST } from '@/app/api/appointments/[id]/cancel/route';
+import { mailOutbox } from '@/lib/mailer';
+import { query } from '@/lib/db';
+import { call, TOKENS } from './helpers';
+
+const cancel = (id: string, token?: string) =>
+  call(POST, { method: 'POST', path: `/api/appointments/${id}/cancel`, token, params: { id } });
+const status = async (id: string) =>
+  (await query<{ status: string }>('SELECT status FROM appointments WHERE id = ?', [id]))[0].status;
+
+describe('POST /api/appointments/{id}/cancel', () => {
+  it('rejects unauthenticated', async () => {
+    const res = await cancel('apt_001');
+    expect(res.status).toBe(401);
+    expect(await status('apt_001')).toBe('booked');
+  });
+
+  it.each([
+    ['another patient', TOKENS.theo, 'apt_001'],
+    ['another practitioner', TOKENS.malik, 'apt_001'],
+    ['admin', TOKENS.dana, 'apt_001'],
+    ['other practice practitioner', TOKENS.hal, 'apt_001'],
+    ['other practice patient', TOKENS.june, 'apt_001'],
+    ['unknown id', TOKENS.ava, 'apt_nope'],
+  ])('404 for %s', async (_n, token, id) => {
+    const res = await cancel(id, token);
+    expect(res.status).toBe(404);
+    expect(await status('apt_001')).toBe('booked');
+    expect(mailOutbox).toHaveLength(0);
+  });
+
+  it('patient cancels, practitioner is emailed generically', async () => {
+    const res = await cancel('apt_001', TOKENS.ava);
+    expect(res.status).toBe(200);
+    expect(res.json).toEqual({ id: 'apt_001', status: 'cancelled' });
+    expect(await status('apt_001')).toBe('cancelled');
+    expect(mailOutbox).toHaveLength(1);
+    const blob = mailOutbox[0].subject + mailOutbox[0].text;
+    expect(blob).not.toMatch(/Ava|sleep|anxiety|diary|Follow-up/i);
+    expect(blob).toMatch(/portal/);
+  });
+
+  it('second cancel conflicts without another email', async () => {
+    const res = await cancel('apt_001', TOKENS.ava);
+    expect(res.status).toBe(409);
+    expect(mailOutbox).toHaveLength(0);
+  });
+
+  it('practitioner cancels, patient is emailed generically', async () => {
+    const res = await cancel('apt_002', TOKENS.rosa);
+    expect(res.status).toBe(200);
+    expect(await status('apt_002')).toBe('cancelled');
+    expect(mailOutbox).toHaveLength(1);
+    const blob = mailOutbox[0].subject + mailOutbox[0].text;
+    expect(blob).not.toMatch(/Theo|Rosa|Relapse|check-in/i);
+  });
+});
