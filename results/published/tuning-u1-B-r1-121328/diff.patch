+
+export interface AppointmentRef {
+  id: string;
+  org_id: string;
+  patient_id: string;
+  practitioner_id: string;
+  status: AppointmentRow['status'];
+}
+
+/** Ids and status only; no reason, notes or names. */
+export async function getRef(id: string): Promise<AppointmentRef | null> {
+  return queryOne<AppointmentRef>(
+    'SELECT id, org_id, patient_id, practitioner_id, status FROM appointments WHERE id = ?',
+    [id],
+  );
+}
+
+/** Marks a booked appointment cancelled. Returns false if it was not in `booked` state. */
+export async function cancelBooked(id: string): Promise<boolean> {
+  const res = await execute("UPDATE appointments SET status = 'cancelled' WHERE id = ? AND status = 'booked'", [id]);
+  return res.affectedRows > 0;
+}
+
+/** Email address of the practitioner's user account (address only). */
+export async function getPractitionerEmail(practitionerId: string): Promise<string | null> {
+  const row = await queryOne<{ email: string }>(
+    'SELECT u.email AS email FROM practitioners p JOIN users u ON u.id = p.user_id WHERE p.id = ?',
+    [practitionerId],
+  );
+  return row?.email ?? null;
+}
+
+/** Email address of the patient (user account, else patient record). Address only. */
+export async function getPatientEmail(patientId: string): Promise<string | null> {
+  const row = await queryOne<{ email: string | null }>(
+    'SELECT COALESCE(u.email, p.email) AS email FROM patients p LEFT JOIN users u ON u.id = p.user_id WHERE p.id = ?',
+    [patientId],
+  );
+  return row?.email ?? null;
+}
diff --git a/tests/cancel.test.ts b/tests/cancel.test.ts
