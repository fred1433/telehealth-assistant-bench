@@ -0,0 +1,45 @@
+import { env } from './env';
+import { logger } from './logger';
+import { sendMail } from './mailer';
+import { sendPush } from './push';
+import { listPushTokens } from '@/repos/devices';
+
+/**
+ * Tells a user that a secure message is waiting. Generic wording only: no
+ * subject, body, names or reasons. Never throws; failures are logged by id.
+ */
+export async function notifyNewMessage(recipientUserId: string, recipientEmail: string, messageId: string): Promise<void> {
+  const fail = (channel: string, err: unknown) =>
+    logger.error('message notification failed', {
+      messageId,
+      channel,
+      code: (err as { code?: string } | null)?.code ?? 'unknown',
+    });
+
+  try {
+    await sendMail({
+      to: recipientEmail,
+      subject: 'You have a new secure message',
+      text: `A new secure message is waiting for you. Please sign in to the portal to read it: ${env.appBaseUrl}`,
+    });
+  } catch (err) {
+    fail('mail', err);
+  }
+
+  let tokens: string[] = [];
+  try {
+    tokens = await listPushTokens(recipientUserId);
+  } catch (err) {
+    fail('devices', err);
+  }
+  for (const token of tokens) {
+    try {
+      await sendPush({
+        token,
+        notification: { title: 'New secure message', body: 'A new secure message is waiting. Sign in to read it.' },
+      });
+    } catch (err) {
+      fail('push', err);
+    }
+  }
+}
diff --git a/tests/message-notify.test.ts b/tests/message-notify.test.ts
new file mode 100644
