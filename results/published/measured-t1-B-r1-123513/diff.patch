+++ b/tests/message-notify.test.ts
@@ -0,0 +1,58 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/messages/route';
+import { mailOutbox } from '@/lib/mailer';
+import { pushOutbox } from '@/lib/push';
+import * as pushLib from '@/lib/push';
+import { call, TOKENS } from './helpers';
+
+const SUBJECT = 'Zebra-subject-91';
+const BODY = 'Zebra-body-text about panic attacks';
+
+function send() {
+  return call(POST, {
+    method: 'POST',
+    token: TOKENS.rosa,
+    body: { recipientUserId: 'usr_ava', patientId: 'pt_ava', subject: SUBJECT, body: BODY },
+  });
+}
+
+describe('new secure message notification', () => {
+  beforeEach(() => {
+    mailOutbox.length = 0;
+    pushOutbox.length = 0;
+    vi.restoreAllMocks();
+  });
+
+  it('sends one generic email and one push per device, with no PHI', async () => {
+    const res = await send();
+    expect(res.status).toBe(201);
+    expect(mailOutbox).toHaveLength(1);
+    expect(mailOutbox[0].to).toMatch(/@/);
+    expect(mailOutbox[0].text).toContain('http');
+    expect(pushOutbox.map((p) => p.token).sort()).toEqual(['fcm-dev-ava-phone', 'fcm-dev-ava-tablet']);
+    const all = JSON.stringify([mailOutbox, pushOutbox]).toLowerCase();
+    for (const s of [SUBJECT, 'zebra', 'panic', 'ava', 'rosa', 'pt_ava']) {
+      // the recipient address itself may contain a name; check content fields only
+      const content = JSON.stringify([
+        mailOutbox.map((m) => [m.subject, m.text]),
+        pushOutbox.map((p) => [p.notification, p.data]),
+      ]).toLowerCase();
+      expect(content).not.toContain(s);
+    }
+    expect(all).toBeTruthy();
+  });
+
+  it('still answers 201 and logs no PHI when mail and push fail', async () => {
+    const out: string[] = [];
+    vi.spyOn(process.stdout, 'write').mockImplementation((c: any) => (out.push(String(c)), true));
+    vi.spyOn(process.stderr, 'write').mockImplementation((c: any) => (out.push(String(c)), true));
+    vi.spyOn(pushLib, 'sendPush').mockRejectedValue(Object.assign(new Error('boom ' + SUBJECT), { sql: BODY }));
+    const mailer = await import('@/lib/mailer');
+    vi.spyOn(mailer, 'sendMail').mockRejectedValue(Object.assign(new Error('smtp ' + BODY), { code: 'ECONNREFUSED' }));
+    const res = await send();
+    expect(res.status).toBe(201);
+    expect(res.json.id).toMatch(/^msg_/);
+    const logs = out.join('');
+    for (const s of ['zebra', 'panic', 'ava@', 'Ava']) expect(logs).not.toContain(s);
+  });
+});
