diff --git a/src/lib/scheduleCache.ts b/src/lib/scheduleCache.ts
new file mode 100644
index 0000000..9f9fab6
--- /dev/null
+++ b/src/lib/scheduleCache.ts
@@ -0,0 +1,30 @@
+import { getRedis, KEY_PREFIX } from './redis';
+
+/** Short on purpose: the value holds patient names. Well under the 15 minute ceiling. */
+const TTL_SECONDS = 60;
+
+/** Key holds only the practitioner id and the day: no patient identifier. */
+function key(practitionerId: string, day: string): string {
+  return `${KEY_PREFIX}sched:today:${practitionerId}:${day}`;
+}
+
+export async function getCachedDay(practitionerId: string, day: string): Promise<unknown | null> {
+  try {
+    const raw = await getRedis().get(key(practitionerId, day));
+    return raw ? JSON.parse(raw) : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function setCachedDay(practitionerId: string, day: string, value: unknown): Promise<void> {
+  try {
+    await getRedis().set(key(practitionerId, day), JSON.stringify(value), 'EX', TTL_SECONDS);
+  } catch {
+    /* cache is best effort */
+  }
+}
+
+export async function invalidateDay(practitionerId: string, day: string): Promise<void> {
+  await getRedis().del(key(practitionerId, day));
+}
diff --git a/tests/scheduleCache.test.ts b/tests/scheduleCache.test.ts
new file mode 100644
index 0000000..da06331
--- /dev/null
+++ b/tests/scheduleCache.test.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/practitioner/schedule/today/route';
+import { POST as REVOKE } from '@/app/api/admin/care-team/revoke/route';
+import { getRedis, KEY_PREFIX } from '@/lib/redis';
+import { call, TOKENS } from './helpers';
+
+describe('day view cache', () => {
+  it('caches per practitioner with safe keys and a short TTL; no clinical content', async () => {
+    const first = await call(GET, { token: TOKENS.rosa });
+    const second = await call(GET, { token: TOKENS.rosa });
+    expect(second.json).toEqual(first.json);
+
+    const redis = getRedis();
+    const keys = (await redis.keys(`${KEY_PREFIX}sched:*`));
+    expect(keys.length).toBe(1);
+    expect(keys[0]).not.toMatch(/pt_/);
+    const ttl = await redis.ttl(keys[0]);
+    expect(ttl).toBeGreaterThan(0);
+    expect(ttl).toBeLessThanOrEqual(900);
+    const value = (await redis.get(keys[0])) ?? '';
+    expect(value).not.toContain('Follow-up on sleep');
+    expect(value).not.toContain('Bring sleep diary');
+    expect(value).not.toContain('Generalized anxiety');
+  });
+
+  it("does not show one practitioner another's day", async () => {
+    await call(GET, { token: TOKENS.rosa });
+    const malik = await call(GET, { token: TOKENS.malik });
+    expect(malik.json.appointments.map((a: { id: string }) => a.id)).toEqual(['apt_003']);
+  });
+
+  it('drops a patient from the cached day view right after revoke', async () => {
+    const before = await call(GET, { token: TOKENS.rosa });
+    expect(before.json.appointments.map((a: { id: string }) => a.id)).toContain('apt_002');
+    const res = await call(REVOKE, { method: 'POST', token: TOKENS.dana, body: { practitionerId: 'pr_rosa', patientId: 'pt_theo' } });
+    expect(res.status).toBe(200);
+    const after = await call(GET, { token: TOKENS.rosa });
+    expect(after.json.appointments.map((a: { id: string }) => a.id)).toEqual(['apt_001']);
+  });
+});
