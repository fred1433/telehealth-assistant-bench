@@ -0,0 +1,39 @@
+import { query, queryOne } from '@/lib/db';
+
+/** Narrow, explicit column lists for the patient's own record export. */
+
+export function exportPatient(patientId: string) {
+  return queryOne<{
+    id: string;
+    first_name: string;
+    last_name: string;
+    date_of_birth: Date;
+    email: string | null;
+    phone: string | null;
+    mrn: string;
+  }>('SELECT id, first_name, last_name, date_of_birth, email, phone, mrn FROM patients WHERE id = ?', [patientId]);
+}
+
+export function exportAppointments(patientId: string) {
+  return query<{ id: string; starts_at: Date; ends_at: Date; status: string; visit_reason: string | null }>(
+    'SELECT id, starts_at, ends_at, status, visit_reason FROM appointments WHERE patient_id = ? ORDER BY starts_at',
+    [patientId],
+  );
+}
+
+/** Messages the user sent or received (by user id). */
+export function exportMessages(userId: string) {
+  return query<{ id: string; subject: string; body: string; created_at: Date; sender_user_id: string }>(
+    `SELECT id, subject, body, created_at, sender_user_id FROM messages
+      WHERE sender_user_id = ? OR recipient_user_id = ? ORDER BY created_at`,
+    [userId, userId],
+  );
+}
+
+/** General record only: never psychotherapy_notes. */
+export function exportClinicalNotes(patientId: string) {
+  return query<{ id: string; created_at: Date; body: string }>(
+    'SELECT id, created_at, body FROM clinical_notes WHERE patient_id = ? ORDER BY created_at',
+    [patientId],
+  );
+}
