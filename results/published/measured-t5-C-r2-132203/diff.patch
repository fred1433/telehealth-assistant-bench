diff --git a/src/lib/http.ts b/src/lib/http.ts
index 4e3f736..8b41706 100644
--- a/src/lib/http.ts
+++ b/src/lib/http.ts
@@ -1,5 +1,7 @@
 import { NextResponse } from 'next/server';
 import { ZodError } from 'zod';
+import { logger } from './logger';
+import { newId } from './ids';
 
 export class HttpError extends Error {
   constructor(public readonly status: number, public readonly publicMessage: string) {
@@ -17,14 +19,36 @@ type Handler<C> = (req: Request, ctx: C) => Promise<Response>;
  * Wraps a route handler: known HttpErrors become JSON `{ error }` responses,
  * validation errors become 400, anything else becomes a 500.
  */
-export function route<C = unknown>(handler: Handler<C>): Handler<C> {
+export function route<C = unknown>(handler: Handler<C>, name?: string): Handler<C> {
   return async (req, ctx) => {
     try {
       return await handler(req, ctx);
     } catch (err) {
       if (err instanceof HttpError) return json({ error: err.publicMessage }, err.status);
       if (err instanceof ZodError) return json({ error: 'invalid_request' }, 400);
-      return new Response(null, { status: 500 });
+      const errorId = newId('err');
+      // Only non-identifying fields of the cause: never message/sql/sqlMessage, which can
+      // carry bound values (visit reason, email) from the driver.
+      const e = err as { name?: unknown; code?: unknown; errno?: unknown; sqlState?: unknown };
+      const str = (v: unknown) => (typeof v === 'string' || typeof v === 'number' ? v : undefined);
+      let routeLabel = name;
+      if (!routeLabel) {
+        try {
+          routeLabel = `${req.method} ${new URL(req.url).pathname}`; // path only, no query
+        } catch {
+          routeLabel = 'unknown';
+        }
+      }
+      try {
+        logger.error('unhandled route error', {
+          errorId,
+          route: routeLabel,
+          cause: { name: str(e?.name), code: str(e?.code), errno: str(e?.errno), sqlState: str(e?.sqlState) },
+        });
+      } catch {
+        // logging must never mask the response
+      }
+      return json({ errorId }, 500);
     }
   };
 }
