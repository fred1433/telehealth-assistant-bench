+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/messages/[id]/route';
+import { queryOne } from '@/lib/db';
+import { call, TOKENS } from './helpers';
+
+const get = (token: string | undefined, id = 'msg_001') =>
+  call(GET, { token, path: `/api/messages/${id}`, params: { id } });
+
+const readAt = () => queryOne<{ read_at: Date | null }>('SELECT read_at FROM messages WHERE id = ?', ['msg_001']);
+
+describe('GET /api/messages/{id}', () => {
+  it('requires authentication', async () => {
+    expect((await get(undefined)).status).toBe(401);
+  });
+
+  it.each([
+    ['rosa (sender)', TOKENS.rosa],
+    ['theo', TOKENS.theo],
+    ['dana (admin)', TOKENS.dana],
+    ['hal (other practice)', TOKENS.hal],
+    ['june (other practice)', TOKENS.june],
+  ])('404s for %s and does not mark read', async (_n, token) => {
+    const res = await get(token);
+    expect(res.status).toBe(404);
+    expect(res.json).toEqual({ error: 'not_found' });
+    expect((await readAt())?.read_at).toBeNull();
+  });
+
+  it('404s for a missing message', async () => {
+    expect((await get(TOKENS.ava, 'msg_nope')).status).toBe(404);
+  });
+
+  it('returns exactly the allowed fields to the recipient and marks it read', async () => {
+    const res = await get(TOKENS.ava);
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.json).sort()).toEqual(['body', 'from', 'id', 'sentAt', 'subject']);
+    expect(Object.keys(res.json.from)).toEqual(['name']);
+    expect(res.json.id).toBe('msg_001');
+    expect(res.json.body).toContain('sleep diary');
+    expect((await readAt())?.read_at).not.toBeNull();
+  });
+});
