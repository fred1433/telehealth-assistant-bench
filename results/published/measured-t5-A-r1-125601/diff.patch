diff --git a/src/lib/http.ts b/src/lib/http.ts
index 4e3f736..f1155fa 100644
--- a/src/lib/http.ts
+++ b/src/lib/http.ts
@@ -1,5 +1,7 @@
 import { NextResponse } from 'next/server';
+import { randomUUID } from 'node:crypto';
 import { ZodError } from 'zod';
+import { logger } from './logger';
 
 export class HttpError extends Error {
   constructor(public readonly status: number, public readonly publicMessage: string) {
@@ -11,6 +13,28 @@ export function json(data: unknown, status = 200): NextResponse {
   return NextResponse.json(data, { status });
 }
 
+function routeOf(req: Request): string {
+  try {
+    return `${req.method} ${new URL(req.url).pathname}`;
+  } catch {
+    return `${req.method} unknown`;
+  }
+}
+
+// Driver messages can embed submitted values (e.g. "Incorrect datetime value: '...'"),
+// so only schema-level errors keep their full message; quoted values are redacted otherwise.
+const SCHEMA_CODES = new Set(['ER_BAD_FIELD_ERROR', 'ER_NO_SUCH_TABLE']);
+
+/** Describes an error without request data: never includes `sql`, params or raw values. */
+function safeCause(err: unknown): Record<string, unknown> {
+  if (!(err instanceof Error)) return { name: typeof err };
+  const e = err as Error & { code?: unknown; errno?: unknown; sqlState?: unknown; sqlMessage?: unknown };
+  const code = typeof e.code === 'string' ? e.code : undefined;
+  const raw = typeof e.sqlMessage === 'string' ? e.sqlMessage : e.message;
+  const message = code && SCHEMA_CODES.has(code) ? raw : raw.replace(/'[^']*'/g, "'?'").replace(/"[^"]*"/g, '"?"');
+  return { name: e.name, code, errno: e.errno, sqlState: e.sqlState, message };
+}
+
 type Handler<C> = (req: Request, ctx: C) => Promise<Response>;
 
 /**
@@ -24,7 +48,9 @@ export function route<C = unknown>(handler: Handler<C>): Handler<C> {
     } catch (err) {
       if (err instanceof HttpError) return json({ error: err.publicMessage }, err.status);
       if (err instanceof ZodError) return json({ error: 'invalid_request' }, 400);
-      return new Response(null, { status: 500 });
+      const errorId = `err_${randomUUID()}`;
+      logger.error('unhandled route error', { errorId, route: routeOf(req), cause: safeCause(err) });
+      return json({ errorId }, 500);
     }
   };
 }
