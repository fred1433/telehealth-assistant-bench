+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { GET } from '@/app/api/crisis-contact/route';
+import { query } from '@/lib/db';
+import { call, TOKENS } from './helpers';
+
+describe('GET /api/crisis-contact', () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it('returns the on-call practitioner, audits it, logs without identifiers', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    const res = await call(GET, { token: TOKENS.ava });
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.json).sort()).toEqual(['name', 'phone']);
+    expect(res.json.name).toContain('Rosa');
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    expect(logged).toContain('crisis contact served');
+    for (const s of ['Ava', 'pt_', 'ava@', 'Rosa']) expect(logged).not.toContain(s);
+    const rows = await query<{ target_id: string }>('SELECT target_id FROM audit_log WHERE action = ?', ['crisis_contact.read']);
+    expect(rows.length).toBe(1);
+    expect(rows[0].target_id).toBe('pr_rosa');
+  });
+
+  it('403 for non-patients, 401 unauthenticated', async () => {
+    expect((await call(GET, { token: TOKENS.rosa })).status).toBe(403);
+    expect((await call(GET, { token: TOKENS.dana })).status).toBe(403);
+    expect((await call(GET, { token: TOKENS.hal })).status).toBe(403);
+    expect((await call(GET)).status).toBe(401);
+  });
+
+  it("never returns another practice's on-call practitioner", async () => {
+    const res = await call(GET, { token: TOKENS.june });
+    expect(res.text).not.toContain('Rosa');
+    expect([200, 404]).toContain(res.status);
+  });
+});
