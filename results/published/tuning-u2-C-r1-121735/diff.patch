+export interface CrisisContactRow {
+  id: string;
+  full_name: string;
+  phone: string | null;
+}
+
+/** Narrow lookup for the crisis contact: only the columns the endpoint returns. */
+export async function getOnCallCrisisContact(orgId: string): Promise<CrisisContactRow | null> {
+  return queryOne<CrisisContactRow>(
+    'SELECT id, full_name, phone FROM practitioners WHERE org_id = ? AND on_call = 1 LIMIT 1',
+    [orgId],
+  );
+}
+
 export async function getOnCallPractitioner(orgId: string): Promise<PractitionerRow | null> {
