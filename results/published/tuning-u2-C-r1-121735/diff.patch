+import { requireUser } from '@/lib/auth';
+import { audit } from '@/lib/audit';
+import { json, route, HttpError } from '@/lib/http';
+import { logger } from '@/lib/logger';
+import { getOnCallCrisisContact } from '@/repos/practitioners';
+
+/** The on-call practitioner of the signed-in patient's own practice. */
+export const GET = route(async (req) => {
+  const user = await requireUser(req);
+  if (user.role !== 'patient' || !user.patientId) throw new HttpError(403, 'forbidden');
+  const p = await getOnCallCrisisContact(user.orgId);
+  if (!p) throw new HttpError(404, 'not_found');
+  await audit(user, 'crisis_contact.read', 'practitioner', p.id);
+  logger.info('crisis contact served');
+  return json({ name: p.full_name, phone: p.phone });
+});
