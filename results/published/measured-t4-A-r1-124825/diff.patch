diff --git a/src/lib/dayViewCache.ts b/src/lib/dayViewCache.ts
new file mode 100644
index 0000000..8fb8b60
--- /dev/null
+++ b/src/lib/dayViewCache.ts
@@ -0,0 +1,30 @@
+import { getRedis, KEY_PREFIX } from './redis';
+
+/** Entries live 30s; the generation counter outlives them (15 min max). */
+const ENTRY_TTL_SECONDS = 30;
+const GEN_TTL_SECONDS = 900;
+
+const genKey = (practitionerId: string) => `${KEY_PREFIX}dayview:gen:${practitionerId}`;
+const entryKey = (practitionerId: string, gen: string, day: string) =>
+  `${KEY_PREFIX}dayview:${practitionerId}:${gen}:${day}`;
+
+/**
+ * Per-practitioner cache of the day-view response. Keys hold only the practitioner id,
+ * a generation number and the day. Invalidation bumps the generation, so a read that was
+ * in flight during an invalidation can never repopulate a visible entry.
+ */
+export async function cachedDayView<T>(practitionerId: string, day: string, load: () => Promise<T>): Promise<T> {
+  const redis = getRedis();
+  const gen = (await redis.get(genKey(practitionerId))) ?? '0';
+  const key = entryKey(practitionerId, gen, day);
+  const hit = await redis.get(key);
+  if (hit) return JSON.parse(hit) as T;
+  const value = await load();
+  await redis.set(key, JSON.stringify(value), 'EX', ENTRY_TTL_SECONDS);
+  return value;
+}
+
+export async function invalidateDayView(practitionerId: string): Promise<void> {
+  const redis = getRedis();
+  await redis.multi().incr(genKey(practitionerId)).expire(genKey(practitionerId), GEN_TTL_SECONDS).exec();
+}
