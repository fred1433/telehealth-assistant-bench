+++ b/src/app/api/messages/[id]/route.ts
@@ -0,0 +1,17 @@
+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { getForRecipient, markRead } from '@/repos/messages';
+
+type Ctx = { params: Promise<{ id: string }> };
+
+/** Opens a message; only its recipient may read it (everyone else gets 404). */
+export const GET = route<Ctx>(async (req, { params }) => {
+  const user = await requireUser(req);
+  const { id } = await params;
+  const msg = await getForRecipient(id, user.id);
+  if (!msg) throw new HttpError(404, 'not_found');
+  await markRead(msg.id);
+  await audit(user, 'message.read', 'message', msg.id);
+  return json({ id: msg.id, subject: msg.subject, body: msg.body, sentAt: msg.created_at, from: { name: msg.sender_name } });
+});
diff --git a/src/repos/messages.ts b/src/repos/messages.ts
index 7c73775..19b6d9f 100644
--- a/src/repos/messages.ts
+++ b/src/repos/messages.ts
@@ -68,3 +68,16 @@ export async function getMessage(messageId: string): Promise<MessageRow | null>
 export async function markRead(messageId: string): Promise<void> {
   await execute('UPDATE messages SET read_at = UTC_TIMESTAMP(3) WHERE id = ? AND read_at IS NULL', [messageId]);
 }
+
+/** A message for its recipient only (null if it doesn't exist or belongs to someone else). */
+export async function getForRecipient(
+  messageId: string,
+  recipientUserId: string,
+): Promise<{ id: string; subject: string; body: string; created_at: Date; sender_name: string } | null> {
+  return queryOne(
+    `SELECT m.id, m.subject, m.body, m.created_at, u.display_name AS sender_name
+       FROM messages m JOIN users u ON u.id = m.sender_user_id
+      WHERE m.id = ? AND m.recipient_user_id = ?`,
+    [messageId, recipientUserId],
+  );
+}
