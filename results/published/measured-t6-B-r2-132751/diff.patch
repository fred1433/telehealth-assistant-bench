+import { describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/patients/search/route';
+import { call, TOKENS } from './helpers';
+
+const search = (token: string | undefined, q: unknown) =>
+  call(POST, { method: 'POST', path: '/api/patients/search', token, body: { q } });
+
+describe('POST /api/patients/search', () => {
+  it('matches first or last name, anywhere, case-insensitively', async () => {
+    const a = await search(TOKENS.rosa, 'LIND');
+    expect(a.status).toBe(200);
+    expect(a.json.results.map((r: { id: string }) => r.id)).toEqual(['pt_ava']);
+    const b = await search(TOKENS.malik, 'iya');
+    expect(b.json.results.map((r: { id: string }) => r.id)).toEqual(['pt_priya']);
+    expect(Object.keys(a.json.results[0]).sort()).toEqual(['dateOfBirth', 'firstName', 'id', 'lastName']);
+  });
+
+  it('does not leak other fields', async () => {
+    const res = await search(TOKENS.rosa, 'Theo');
+    expect(res.text).not.toContain('mail.example');
+    expect(res.text).not.toContain('JH-0001');
+    expect(res.text).not.toContain('remission');
+  });
+
+  it('stays inside the practitioner practice', async () => {
+    const res = await search(TOKENS.rosa, 'Lindg');
+    expect(res.json.results).toEqual([]);
+    const hal = await search(TOKENS.hal, 'Lind');
+    expect(hal.json.results.map((r: { id: string }) => r.id)).toEqual(['pt_june']);
+  });
+
+  it('treats LIKE wildcards literally', async () => {
+    expect((await search(TOKENS.rosa, '%%')).json.results).toEqual([]);
+    expect((await search(TOKENS.rosa, '__')).json.results).toEqual([]);
+  });
+
+  it('rejects short queries', async () => {
+    expect((await search(TOKENS.rosa, 'a')).status).toBe(400);
+    expect((await search(TOKENS.rosa, undefined)).status).toBe(400);
+  });
+
+  it('403 for other roles, 401 when unauthenticated', async () => {
+    expect((await search(TOKENS.ava, 'Ava')).status).toBe(403);
+    expect((await search(TOKENS.dana, 'Ava')).status).toBe(403);
+    expect((await search(undefined, 'Ava')).status).toBe(401);
+  });
+
+  it('does not log the search term', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    await search(TOKENS.rosa, 'Marchetti');
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    expect(logged).not.toContain('Marchetti');
+    out.mockRestore();
+    err.mockRestore();
+  });
+});
