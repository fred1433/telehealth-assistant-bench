-import { queryOne } from '@/lib/db';
+import { query, queryOne } from '@/lib/db';
+
+export interface PatientSearchRow {
+  id: string;
+  first_name: string;
+  last_name: string;
+  date_of_birth: Date;
+}
+
+/** Name search within one practice. The fragment is a bound parameter; LIKE wildcards are escaped. */
+export async function searchByName(orgId: string, fragment: string, limit: number): Promise<PatientSearchRow[]> {
+  const like = `%${fragment.replace(/[\\%_]/g, '\\$&')}%`;
+  return query<PatientSearchRow>(
+    'SELECT id, first_name, last_name, date_of_birth FROM patients ' +
+      'WHERE org_id = ? AND (first_name LIKE ? OR last_name LIKE ?) ORDER BY last_name, first_name, id LIMIT ?',
+    [orgId, like, like, limit],
+  );
+}
 
