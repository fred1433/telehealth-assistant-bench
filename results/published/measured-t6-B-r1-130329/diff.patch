+++ b/tests/patient-search.test.ts
@@ -0,0 +1,70 @@
+import { describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/patients/search/route';
+import { call, TOKENS } from './helpers';
+
+const search = (token: string | undefined, body: unknown) =>
+  call(POST, { method: 'POST', path: '/api/patients/search', token, body });
+
+describe('POST /api/patients/search', () => {
+  it('matches first or last name fragments case-insensitively, in the own practice only', async () => {
+    const res = await search(TOKENS.rosa, { q: 'LIND' });
+    expect(res.status).toBe(200);
+    expect(res.json.results).toEqual([
+      { id: 'pt_ava', firstName: 'Ava', lastName: 'Lindqvist', dateOfBirth: '1991-04-12' },
+    ]);
+    const mid = await search(TOKENS.malik, { q: 'rIy' });
+    expect(mid.json.results.map((r: { id: string }) => r.id)).toEqual(['pt_priya']);
+  });
+
+  it('never returns other practice patients, and Hal only sees his own', async () => {
+    const res = await search(TOKENS.hal, { q: 'lind' });
+    expect(res.json.results.map((r: { id: string }) => r.id)).toEqual(['pt_june']);
+  });
+
+  it('returns only the four fields', async () => {
+    const res = await search(TOKENS.rosa, { q: 'Ava' });
+    expect(Object.keys(res.json.results[0]).sort()).toEqual(['dateOfBirth', 'firstName', 'id', 'lastName']);
+    expect(res.text).not.toContain('JH-000101');
+    expect(res.text).not.toContain('mail.example');
+    expect(res.text).not.toContain('anxiety');
+  });
+
+  it('treats LIKE wildcards literally', async () => {
+    expect((await search(TOKENS.rosa, { q: '%%' })).json.results).toEqual([]);
+    expect((await search(TOKENS.rosa, { q: '__' })).json.results).toEqual([]);
+  });
+
+  it('rejects short or invalid input with 400 and echoes nothing', async () => {
+    for (const body of [{ q: 'a' }, { q: ' a ' }, {}, { q: 5 }]) {
+      const res = await search(TOKENS.rosa, body);
+      expect(res.status).toBe(400);
+      expect(res.text).not.toContain('Ava');
+    }
+  });
+
+  it('is for practitioners only', async () => {
+    expect((await search(TOKENS.ava, { q: 'Ava' })).status).toBe(403);
+    expect((await search(TOKENS.dana, { q: 'Ava' })).status).toBe(403);
+    expect((await search(TOKENS.june, { q: 'Ava' })).status).toBe(403);
+  });
+
+  it('requires authentication', async () => {
+    expect((await search(undefined, { q: 'Ava' })).status).toBe(401);
+  });
+
+  it('does not accept the search term in the query string', async () => {
+    const res = await call(POST, { method: 'POST', path: '/api/patients/search?q=Ava', token: TOKENS.rosa, body: {} });
+    expect(res.status).toBe(400);
+  });
+
+  it('logs no names or SQL', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    await search(TOKENS.rosa, { q: 'Lindqvist' });
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    out.mockRestore();
+    err.mockRestore();
+    expect(logged).not.toContain('Lindqvist');
+    expect(logged).not.toContain('SELECT');
+  });
+});
