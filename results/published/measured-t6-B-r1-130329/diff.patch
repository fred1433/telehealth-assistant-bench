 }
 
+export interface PatientSearchRow {
+  id: string;
+  first_name: string;
+  last_name: string;
+  date_of_birth: Date;
+}
+
+/** Name-fragment search inside one org. Explicit columns only; LIKE wildcards in the fragment are escaped. */
+export async function searchByName(orgId: string, fragment: string, limit: number): Promise<PatientSearchRow[]> {
+  const like = `%${fragment.replace(/[\\%_]/g, '\\$&')}%`;
+  return query<PatientSearchRow>(
+    'SELECT id, first_name, last_name, date_of_birth FROM patients WHERE org_id = ? AND (first_name LIKE ? OR last_name LIKE ?) ORDER BY last_name, first_name, id LIMIT ?',
+    [orgId, like, like, limit],
+  );
+}
+
 export async function getPatientByUserId(userId: string): Promise<PatientRow | null> {
   return queryOne<PatientRow>('SELECT * FROM patients WHERE user_id = ?', [userId]);
 }
diff --git a/tests/patient-search.test.ts b/tests/patient-search.test.ts
new file mode 100644
index 0000000..4fcea02
