+++ b/src/lib/notify.ts
@@ -0,0 +1,40 @@
+import { env } from './env';
+import { logger } from './logger';
+import { sendMail } from './mailer';
+import { sendPush } from './push';
+import { listPushTokens } from '@/repos/devices';
+
+const TITLE = 'New secure message';
+const PUSH_BODY = 'A new secure message is waiting. Sign in to read it.';
+
+/**
+ * Tells a user a secure message is waiting. Content-free by design (no PHI).
+ * Never throws; failures are logged with ids only.
+ */
+export async function notifyNewMessage(recipient: { id: string; email: string }, messageId: string): Promise<void> {
+  const fail = (channel: string) =>
+    logger.warn('message notification failed', { messageId, recipientId: recipient.id, channel });
+
+  try {
+    await sendMail({
+      to: recipient.email,
+      subject: TITLE,
+      text: `A new secure message is waiting for you. Please sign in to read it: ${env.appBaseUrl}`,
+    });
+  } catch {
+    fail('email');
+  }
+
+  let tokens: string[] = [];
+  try {
+    tokens = await listPushTokens(recipient.id);
+  } catch {
+    fail('push');
+    return;
+  }
+  await Promise.all(
+    tokens.map((token) =>
+      sendPush({ token, notification: { title: TITLE, body: PUSH_BODY } }).catch(() => fail('push')),
+    ),
+  );
+}
