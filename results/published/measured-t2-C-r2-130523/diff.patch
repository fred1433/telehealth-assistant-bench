+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { getForRecipient, markRead } from '@/repos/messages';
+
+type Ctx = { params: Promise<{ id: string }> };
+
+/** The recipient opens a message; anyone else gets 404. Marks it read. */
+export const GET = route<Ctx>(async (req, { params }) => {
+  const user = await requireUser(req);
+  const { id } = await params;
+  const m = await getForRecipient(id, user.id);
+  if (!m) throw new HttpError(404, 'not_found');
+  await markRead(m.id);
+  await audit(user, 'message.read', 'message', m.id);
+  return json({
+    id: m.id,
+    subject: m.subject,
+    body: m.body,
+    sentAt: m.created_at,
+    from: { name: m.sender_name },
+  });
+});
