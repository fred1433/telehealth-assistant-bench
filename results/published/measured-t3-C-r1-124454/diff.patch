@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/me/export/route';
+import { call, TOKENS } from './helpers';
+
+describe('GET /api/me/export', () => {
+  it('exports the patient’s own general record', async () => {
+    const res = await call(GET, { token: TOKENS.ava, path: '/api/me/export' });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_ava');
+    expect(res.json.patient).toHaveProperty('mrn');
+    expect(res.json.appointments.map((a: { id: string }) => a.id).sort()).toEqual(['apt_001', 'apt_004']);
+    const dirs = Object.fromEntries(res.json.messages.map((m: any) => [m.id, m.direction]));
+    expect(dirs).toEqual({ msg_001: 'received', msg_002: 'sent' });
+    expect(res.json.clinicalNotes.map((n: { id: string }) => n.id).sort()).toEqual(['cn_001', 'cn_002']);
+  });
+
+  it('never includes psychotherapy notes, appointment notes or other patients’ data', async () => {
+    const res = await call(GET, { token: TOKENS.ava, path: '/api/me/export' });
+    expect(res.text).not.toContain('pn_001');
+    expect(res.text).not.toContain('transference');
+    expect(res.text).not.toContain('Bring sleep diary');
+    expect(res.text).not.toContain('cn_003');
+    expect(res.text).not.toContain('pt_theo');
+    expect(res.text).not.toContain('Relapse');
+  });
+
+  it('is scoped to the caller', async () => {
+    const res = await call(GET, { token: TOKENS.june, path: '/api/me/export' });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_june');
+    expect(res.json.messages).toEqual([]);
+    expect(res.text).not.toContain('pt_ava');
+  });
+
+  it.each(['rosa', 'dana', 'hal'] as const)('refuses %s', async (who) => {
+    const res = await call(GET, { token: TOKENS[who], path: '/api/me/export' });
+    expect(res.status).toBe(403);
+  });
+
+  it('requires authentication', async () => {
+    const res = await call(GET, { path: '/api/me/export' });
+    expect(res.status).toBe(401);
+  });
+});
