@@ -0,0 +1,34 @@
+import { env } from './env';
+import { logger } from './logger';
+import { sendMail } from './mailer';
+import { sendPush } from './push';
+import { listPushTokens } from '@/repos/devices';
+
+/**
+ * Tells a user a secure message is waiting. Content is generic on purpose (no PHI).
+ * Never throws: failures are logged with ids only.
+ */
+export async function notifyNewSecureMessage(recipient: { id: string; email: string }, messageId: string): Promise<void> {
+  const title = 'New secure message';
+  const text = `You have a new secure message waiting. Please sign in to read it: ${env.appBaseUrl}`;
+
+  try {
+    await sendMail({ to: recipient.email, subject: title, text });
+  } catch {
+    logger.warn('message email failed', { messageId, recipientId: recipient.id });
+  }
+
+  let tokens: string[] = [];
+  try {
+    tokens = await listPushTokens(recipient.id);
+  } catch {
+    logger.warn('push token lookup failed', { messageId, recipientId: recipient.id });
+  }
+  await Promise.all(
+    tokens.map((token) =>
+      sendPush({ token, notification: { title, body: 'Sign in to read it.' } }).catch(() => {
+        logger.warn('message push failed', { messageId, recipientId: recipient.id });
+      }),
+    ),
+  );
+}
