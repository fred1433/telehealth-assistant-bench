+function errCode(err: unknown): string {
+  const code = (err as { code?: unknown } | null)?.code;
+  return typeof code === 'string' ? code : 'unknown';
+}
+
+/** Generic "new message" email + push. Never includes message content or patient data; failures are logged by id/code only. */
+async function notifyRecipient(messageId: string, recipientId: string, email: string): Promise<void> {
+  try {
+    await sendMail({
+      to: email,
+      subject: 'You have a new secure message',
+      text: `A new secure message is waiting for you. Sign in to read it: ${env.appBaseUrl}`,
+    });
+  } catch (err) {
+    logger.error('message email failed', { messageId, code: errCode(err) });
+  }
+  try {
+    const tokens = await listPushTokens(recipientId);
+    for (const token of tokens) {
+      try {
+        await sendPush({
+          token,
+          notification: { title: 'New secure message', body: 'A new secure message is waiting. Sign in to read it.' },
+        });
+      } catch (err) {
+        logger.error('message push failed', { messageId, code: errCode(err) });
+      }
+    }
+  } catch (err) {
+    logger.error('message push lookup failed', { messageId, code: errCode(err) });
+  }
+}
