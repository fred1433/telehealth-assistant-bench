+// DB driver messages for these codes name only schema objects, never row values.
+const VALUE_FREE_DB_CODES = new Set(['ER_BAD_FIELD_ERROR', 'ER_NO_SUCH_TABLE', 'ER_NO_REFERENCED_ROW_2', 'ER_BAD_NULL_ERROR']);
+
+/**
+ * Describes an unexpected error without patient data. mysql2 errors carry the interpolated SQL
+ * (`sql`) and may quote row values in the message, so only codes (and value-free messages) are kept.
+ */
+function safeCause(err: unknown): Record<string, unknown> {
+  if (!(err instanceof Error)) return { type: typeof err };
+  const e = err as Error & { code?: string; errno?: number; sqlState?: string; sqlMessage?: string; sql?: string };
+  const out: Record<string, unknown> = { name: e.name };
+  if (e.code) out.code = e.code;
+  if (e.errno) out.errno = e.errno;
+  if (e.sqlState) out.sqlState = e.sqlState;
+  const isDb = e.sql !== undefined || e.sqlMessage !== undefined;
+  if (!isDb) out.message = e.message;
+  else if (e.code && VALUE_FREE_DB_CODES.has(e.code)) out.message = e.sqlMessage ?? e.message;
+  return out;
+}
+
+function routeName(req: Request): string {
+  try {
+    return `${req.method} ${new URL(req.url).pathname}`;
+  } catch {
