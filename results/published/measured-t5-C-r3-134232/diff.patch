diff --git a/src/lib/http.ts b/src/lib/http.ts
index 4e3f736..7211f9c 100644
--- a/src/lib/http.ts
+++ b/src/lib/http.ts
@@ -1,5 +1,7 @@
 import { NextResponse } from 'next/server';
 import { ZodError } from 'zod';
+import { randomUUID } from 'node:crypto';
+import { logger } from './logger';
 
 export class HttpError extends Error {
   constructor(public readonly status: number, public readonly publicMessage: string) {
@@ -24,7 +26,22 @@ export function route<C = unknown>(handler: Handler<C>): Handler<C> {
     } catch (err) {
       if (err instanceof HttpError) return json({ error: err.publicMessage }, err.status);
       if (err instanceof ZodError) return json({ error: 'invalid_request' }, 400);
-      return new Response(null, { status: 500 });
+      const errorId = randomUUID();
+      let routePath = 'unknown';
+      try {
+        routePath = new URL(req.url).pathname; // never the query string
+      } catch {}
+      const e = err as { code?: unknown; name?: unknown } | null;
+      // Cause: error name and driver/system code only. Messages and `sql` can carry bound PHI.
+      const causeName = typeof e?.name === 'string' ? e.name : typeof err;
+      const causeCode = typeof e?.code === 'string' || typeof e?.code === 'number' ? e.code : undefined;
+      logger.error('unhandled route error', {
+        errorId,
+        route: `${req.method} ${routePath}`,
+        causeName,
+        causeCode,
+      });
+      return json({ errorId }, 500);
     }
   };
 }
