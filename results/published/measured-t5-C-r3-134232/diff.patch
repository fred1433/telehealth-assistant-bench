+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    const bad = route(async () => {
+      throw Object.assign(new Error('Duplicate entry [account]'), {
+        code: 'ER_DUP_ENTRY',
+        sql: 'INSERT insomnia follow-up',
+        sqlMessage: 'Duplicate entry [account]',
+      });
+    });
+    const res = await call(bad, { method: 'POST', path: '/api/appointments?name=Ava' });
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    out.mockRestore();
+    err.mockRestore();
+    expect(res.status).toBe(500);
+    expect(Object.keys(res.json)).toEqual(['errorId']);
+    expect(logged).toContain(res.json.errorId);
+    expect(logged).toContain('ER_DUP_ENTRY');
+    expect(logged).toContain('/api/appointments');
+    for (const s of ['ava@', 'insomnia', 'INSERT', 'Ava', 'name=']) expect(logged).not.toContain(s);
