+/** General-record notes only; psychotherapy_notes are never read here. */
+export async function listClinicalForPatient(patientId: string): Promise<Array<{ id: string; created_at: Date; body: string }>> {
+  return query('SELECT id, created_at, body FROM clinical_notes WHERE patient_id = ? ORDER BY created_at, id', [patientId]);
+}
