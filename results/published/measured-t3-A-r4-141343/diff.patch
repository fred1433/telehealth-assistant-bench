 export async function markRead(messageId: string): Promise<void> {
   await execute('UPDATE messages SET read_at = UTC_TIMESTAMP(3) WHERE id = ? AND read_at IS NULL', [messageId]);
 }
+
+/** Every message a user sent or received, oldest first (for the patient's own export). */
+export async function listForUser(userId: string): Promise<MessageRow[]> {
+  return query<MessageRow>(
+    'SELECT * FROM messages WHERE sender_user_id = ? OR recipient_user_id = ? ORDER BY created_at, id',
+    [userId, userId],
+  );
+}
