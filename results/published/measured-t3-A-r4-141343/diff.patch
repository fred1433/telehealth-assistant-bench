+import { describe, expect, it } from 'vitest';
+import { call, TOKENS } from './helpers';
+import { GET } from '@/app/api/me/export/route';
+
+describe('GET /api/me/export', () => {
+  it('returns the patient record without psychotherapy notes', async () => {
+    const r = await call(GET, { token: TOKENS.ava, path: '/api/me/export' });
+    expect(r.status).toBe(200);
+    expect(r.json.patient.mrn).toBeTruthy();
+    expect(Array.isArray(r.json.appointments)).toBe(true);
+    expect(Array.isArray(r.json.clinicalNotes)).toBe(true);
+    for (const m of r.json.messages) expect(['sent', 'received']).toContain(m.direction);
+    expect(r.json.psychotherapyNotes).toBeUndefined();
+  });
+  it('rejects other roles and anonymous', async () => {
+    expect((await call(GET, { token: TOKENS.rosa })).status).toBe(403);
+    expect((await call(GET, { token: TOKENS.dana })).status).toBe(403);
+    expect((await call(GET)).status).toBe(401);
+  });
+});
