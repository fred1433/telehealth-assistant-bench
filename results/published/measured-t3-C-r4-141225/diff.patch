+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { getExportProfile } from '@/repos/patients';
+import { listExportForPatient } from '@/repos/appointments';
+import { listExportForUser } from '@/repos/messages';
+import { listClinicalForPatient } from '@/repos/notes';
+
+/** The signed-in patient's own record (general record only; no psychotherapy notes). */
+export const GET = route(async (req) => {
+  const user = await requireUser(req);
+  if (user.role !== 'patient' || !user.patientId) throw new HttpError(403, 'forbidden');
+  const p = await getExportProfile(user.patientId);
+  if (!p) throw new HttpError(404, 'not_found');
+
+  const [appointments, messages, notes] = await Promise.all([
+    listExportForPatient(p.id),
+    listExportForUser(user.id),
+    listClinicalForPatient(p.id),
+  ]);
+  await audit(user, 'record.export', 'patient', p.id);
+
+  const res = json({
+    patient: {
+      id: p.id,
+      firstName: p.first_name,
+      lastName: p.last_name,
+      dateOfBirth: p.date_of_birth,
+      email: p.email,
+      phone: p.phone,
+      mrn: p.mrn,
+    },
+    appointments: appointments.map((a) => ({
+      id: a.id,
+      startsAt: a.starts_at,
+      endsAt: a.ends_at,
+      status: a.status,
+      visitReason: a.visit_reason,
+    })),
+    messages: messages.map((m) => ({ id: m.id, subject: m.subject, body: m.body, sentAt: m.created_at, direction: m.direction })),
+    clinicalNotes: notes.map((n) => ({ id: n.id, createdAt: n.created_at, body: n.body })),
+  });
+  res.headers.set('cache-control', 'no-store');
+  return res;
+});
