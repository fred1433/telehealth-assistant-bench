+++ b/tests/export.test.ts
@@ -0,0 +1,64 @@
+import { describe, expect, it, vi } from 'vitest';
+import { GET } from '@/app/api/me/export/route';
+import { call, TOKENS } from './helpers';
+
+describe('GET /api/me/export', () => {
+  it('returns the patient\'s own general record', async () => {
+    const res = await call(GET, { token: TOKENS.ava });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_ava');
+    expect(Object.keys(res.json.patient).sort()).toEqual(['dateOfBirth', 'email', 'firstName', 'id', 'lastName', 'mrn', 'phone']);
+    expect(res.json.appointments.map((a: { id: string }) => a.id)).toContain('apt_001');
+    for (const a of res.json.appointments) {
+      expect(Object.keys(a).sort()).toEqual(['endsAt', 'id', 'startsAt', 'status', 'visitReason']);
+    }
+    const dirs = Object.fromEntries(res.json.messages.map((m: { id: string; direction: string }) => [m.id, m.direction]));
+    expect(dirs.msg_001).toBe('received');
+    expect(dirs.msg_002).toBe('sent');
+    expect(res.json.clinicalNotes.length).toBeGreaterThan(0);
+  });
+
+  it('never includes psychotherapy notes or practitioner appointment notes', async () => {
+    const res = await call(GET, { token: TOKENS.ava });
+    expect(res.text).not.toContain('pn_001');
+    expect(res.text).not.toContain('transference');
+    expect(res.text).not.toContain('reasonForCare');
+    expect(res.json.clinicalNotes.every((n: { id: string }) => !n.id.startsWith('pn_'))).toBe(true);
+  });
+
+  it('does not leak another patient\'s data', async () => {
+    const res = await call(GET, { token: TOKENS.theo });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_theo');
+    expect(res.text).not.toContain('pt_ava');
+    expect(res.text).not.toContain('msg_001');
+    expect(res.text).not.toContain('apt_001');
+    expect(res.text).not.toContain('shame narrative');
+  });
+
+  it('refuses non-patient roles and anonymous callers', async () => {
+    expect((await call(GET, { token: TOKENS.rosa })).status).toBe(403);
+    expect((await call(GET, { token: TOKENS.dana })).status).toBe(403);
+    expect((await call(GET, { token: TOKENS.hal })).status).toBe(403);
+    expect((await call(GET)).status).toBe(401);
+  });
+
+  it('works for a patient of another practice, scoped to them', async () => {
+    const res = await call(GET, { token: TOKENS.june });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_june');
+    expect(res.text).not.toContain('pt_ava');
+  });
+
+  it('writes nothing identifying to the logs', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    await call(GET, { token: TOKENS.ava });
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    out.mockRestore();
+    err.mockRestore();
+    expect(logged).not.toContain('sleep diary');
+    expect(logged).not.toContain('nights were rough');
+    expect(logged).not.toMatch(/SELECT|INSERT/);
+  });
+});
