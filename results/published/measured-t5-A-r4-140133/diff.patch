diff --git a/src/lib/http.ts b/src/lib/http.ts
index 4e3f736..76c48a0 100644
--- a/src/lib/http.ts
+++ b/src/lib/http.ts
@@ -1,5 +1,7 @@
 import { NextResponse } from 'next/server';
+import { randomBytes } from 'node:crypto';
 import { ZodError } from 'zod';
+import { logger } from './logger';
 
 export class HttpError extends Error {
   constructor(public readonly status: number, public readonly publicMessage: string) {
@@ -11,6 +13,21 @@ export function json(data: unknown, status = 200): NextResponse {
   return NextResponse.json(data, { status });
 }
 
+/**
+ * Diagnostic summary of an error without its message: driver messages and SQL can embed
+ * row values (patient data), so only the type and codes are logged.
+ */
+function safeCause(err: unknown): Record<string, unknown> {
+  if (!(err instanceof Error)) return { name: typeof err };
+  const e = err as unknown as Record<string, unknown>;
+  const out: Record<string, unknown> = { name: err.name };
+  for (const k of ['code', 'errno', 'sqlState']) if (e[k] !== undefined) out[k] = e[k];
+  // MySQL "Unknown column 'x'" style messages name schema objects, not values.
+  const m = typeof e.sqlMessage === 'string' ? /^(Unknown column '[\w.]+' in '[\w ]+')/.exec(e.sqlMessage) : null;
+  if (m) out.detail = m[1];
+  return out;
+}
+
 type Handler<C> = (req: Request, ctx: C) => Promise<Response>;
 
 /**
@@ -24,7 +41,13 @@ export function route<C = unknown>(handler: Handler<C>): Handler<C> {
     } catch (err) {
       if (err instanceof HttpError) return json({ error: err.publicMessage }, err.status);
       if (err instanceof ZodError) return json({ error: 'invalid_request' }, 400);
-      return new Response(null, { status: 500 });
+      const errorId = `err_${randomBytes(8).toString('hex')}`;
+      logger.error('unhandled route error', {
+        errorId,
+        route: `${req.method} ${new URL(req.url).pathname}`,
+        cause: safeCause(err),
+      });
+      return json({ errorId }, 500);
     }
   };
 }
