 }
 
+export interface PatientSearchHit {
+  id: string;
+  first_name: string;
+  last_name: string;
+  date_of_birth: Date;
+}
+
+/** Name-fragment search within one practice. Explicit columns only; max 20 rows. */
+export async function searchByName(orgId: string, fragment: string): Promise<PatientSearchHit[]> {
+  const like = `%${fragment.replace(/[\\%_]/g, (c) => `\\${c}`)}%`;
+  return query<PatientSearchHit>(
+    'SELECT id, first_name, last_name, date_of_birth FROM patients WHERE org_id = ? AND (first_name LIKE ? OR last_name LIKE ?) ORDER BY last_name, first_name, id LIMIT 20',
+    [orgId, like, like],
+  );
+}
+
 export async function getPatientByUserId(userId: string): Promise<PatientRow | null> {
   return queryOne<PatientRow>('SELECT * FROM patients WHERE user_id = ?', [userId]);
 }
diff --git a/tests/patient-search.test.ts b/tests/patient-search.test.ts
new file mode 100644
