+++ b/tests/patient-search.test.ts
@@ -0,0 +1,55 @@
+import { describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/patients/search/route';
+import { call, TOKENS } from './helpers';
+
+const search = (token: string | undefined, q: unknown) =>
+  call(POST, { method: 'POST', path: '/api/patients/search', token, body: { q } });
+
+describe('POST /api/patients/search', () => {
+  it('finds patients of the own practice, case-insensitively, anywhere in the name', async () => {
+    const res = await search(TOKENS.rosa, 'VA');
+    expect(res.status).toBe(200);
+    const ids = res.json.results.map((r: { id: string }) => r.id);
+    expect(ids).toContain('pt_ava');
+    expect(Object.keys(res.json.results[0]).sort()).toEqual(['dateOfBirth', 'firstName', 'id', 'lastName']);
+  });
+
+  it('also reaches practice patients outside the care team', async () => {
+    const res = await search(TOKENS.rosa, 'pri');
+    expect(res.json.results.map((r: { id: string }) => r.id)).toContain('pt_priya');
+  });
+
+  it('never returns patients of another practice', async () => {
+    const res = await search(TOKENS.rosa, 'june');
+    expect(res.status).toBe(200);
+    expect(res.json.results).toEqual([]);
+    const hal = await search(TOKENS.hal, 'ava');
+    expect(hal.json.results).toEqual([]);
+  });
+
+  it('treats wildcards literally', async () => {
+    const res = await search(TOKENS.rosa, '%%');
+    expect(res.json.results).toEqual([]);
+  });
+
+  it('rejects short or missing queries', async () => {
+    expect((await search(TOKENS.rosa, 'a')).status).toBe(400);
+    expect((await search(TOKENS.rosa, undefined)).status).toBe(400);
+  });
+
+  it('refuses other roles and anonymous callers', async () => {
+    expect((await search(TOKENS.ava, 'ava')).status).toBe(403);
+    expect((await search(TOKENS.dana, 'ava')).status).toBe(403);
+    expect((await search(undefined, 'ava')).status).toBe(401);
+  });
+
+  it('does not log the searched name', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    await search(TOKENS.rosa, 'zzqx');
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    expect(logged).not.toContain('zzqx');
+    out.mockRestore();
+    err.mockRestore();
+  });
+});
