 }
 
+/** Path only: the query string is never logged. */
+function routeOf(req: Request): string {
+  try {
+    return new URL(req.url).pathname;
+  } catch {
+    return 'unknown';
+  }
+}
+
+/**
+ * Safe description of an error: class name and driver codes only. `message`, `sql` and
+ * `sqlMessage` can contain bound values (PHI), so they are never logged.
+ */
+function causeOf(err: unknown): Record<string, unknown> {
+  if (!(err instanceof Error)) return { name: typeof err };
+  const e = err as unknown as Record<string, unknown>;
+  const cause: Record<string, unknown> = { name: err.name };
+  for (const k of ['code', 'errno', 'sqlState']) {
+    if (typeof e[k] === 'string' || typeof e[k] === 'number') cause[k] = e[k];
+  }
+  return cause;
+}
