+import { z } from 'zod';
+import { requireUser, requireRole } from '@/lib/auth';
+import { json, readJson, route } from '@/lib/http';
+import { searchPatientsByName } from '@/repos/patients';
+
+// POST (not GET): the name fragment must travel in the body, never in the URL,
+// because the Apache access log records every request line.
+const Body = z.object({ q: z.string().trim().min(2).max(80) });
+
+function isoDate(d: Date | string): string {
+  return d instanceof Date ? d.toISOString().slice(0, 10) : String(d).slice(0, 10);
+}
+
+export const POST = route(async (req) => {
+  const user = await requireUser(req);
+  requireRole(user, 'practitioner');
+  const { q } = Body.parse(await readJson(req));
+  const rows = await searchPatientsByName(user.orgId, q, 20);
+  return json({
+    results: rows.map((r) => ({
+      id: r.id,
+      firstName: r.first_name,
+      lastName: r.last_name,
+      dateOfBirth: isoDate(r.date_of_birth),
+    })),
+  });
+});
