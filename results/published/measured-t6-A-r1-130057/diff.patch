@@ -0,0 +1,30 @@
+import { describe, it, expect } from 'vitest';
+import { call, TOKENS } from './helpers';
+import { POST } from '@/app/api/patients/search/route';
+
+const search = (token: string, q: unknown) =>
+  call(POST, { method: 'POST', path: '/api/patients/search', token, body: { q } });
+
+describe('patient search', () => {
+  it('requires at least 2 characters', async () => {
+    expect((await search(TOKENS.rosa, 'a')).status).toBe(400);
+  });
+  it('finds patients case-insensitively with only the allowed fields', async () => {
+    const r = await search(TOKENS.rosa, 'AV');
+    expect(r.status).toBe(200);
+    expect(r.json.results.length).toBeGreaterThan(0);
+    expect(Object.keys(r.json.results[0]).sort()).toEqual(['dateOfBirth', 'firstName', 'id', 'lastName']);
+  });
+  it('does not cross practices', async () => {
+    const r = await search(TOKENS.hal, 'av');
+    expect(r.status).toBe(200);
+    expect(r.json.results.every((x: any) => x.firstName !== 'Ava')).toBe(true);
+  });
+  it('rejects other roles', async () => {
+    expect((await search(TOKENS.ava, 'av')).status).toBe(403);
+    expect((await search(TOKENS.dana, 'av')).status).toBe(403);
+  });
+  it('treats wildcards literally', async () => {
+    expect((await search(TOKENS.rosa, '%%')).json.results).toEqual([]);
+  });
+});
