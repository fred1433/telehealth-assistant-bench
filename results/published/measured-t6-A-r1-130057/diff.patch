@@ -21,3 +21,26 @@ export async function getPatient(patientId: string): Promise<PatientRow | null>
 export async function getPatientByUserId(userId: string): Promise<PatientRow | null> {
   return queryOne<PatientRow>('SELECT * FROM patients WHERE user_id = ?', [userId]);
 }
+
+export interface PatientSearchRow {
+  id: string;
+  first_name: string;
+  last_name: string;
+  date_of_birth: Date;
+}
+
+/** Case-insensitive substring match on first/last name within one practice. */
+export async function searchPatientsByName(
+  orgId: string,
+  fragment: string,
+  limit = 20,
+): Promise<PatientSearchRow[]> {
+  const escaped = fragment.replace(/[\\%_]/g, (c) => `\\${c}`);
+  const pattern = `%${escaped}%`;
+  return query<PatientSearchRow>(
+    `SELECT id, first_name, last_name, date_of_birth FROM patients
+     WHERE org_id = ? AND (first_name LIKE ? OR last_name LIKE ?)
+     ORDER BY last_name, first_name, id LIMIT ${Math.trunc(limit)}`,
+    [orgId, pattern, pattern],
+  );
+}
