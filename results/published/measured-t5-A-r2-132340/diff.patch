@@ -1,5 +1,32 @@
 import { NextResponse } from 'next/server';
+import { randomUUID } from 'node:crypto';
 import { ZodError } from 'zod';
+import { logger } from './logger';
+
+/** Method + path only (no query string). */
+function routeName(req: Request): string {
+  try {
+    return `${req.method} ${new URL(req.url).pathname}`;
+  } catch {
+    return req.method;
+  }
+}
+
+/**
+ * Describes the underlying cause without content: no SQL or parameters, and quoted
+ * values in driver messages (which may echo row data) are masked.
+ */
+function safeCause(err: unknown): Record<string, unknown> {
+  if (!(err instanceof Error)) return { type: typeof err };
+  const e = err as Error & { code?: unknown; errno?: unknown; sqlState?: unknown };
+  return {
+    name: e.name,
+    code: e.code,
+    errno: e.errno,
+    sqlState: e.sqlState,
+    message: e.message.replace(/'[^']*'/g, '?').replace(/"[^"]*"/g, '?').slice(0, 300),
+  };
+}
 
 export class HttpError extends Error {
   constructor(public readonly status: number, public readonly publicMessage: string) {
@@ -24,7 +51,9 @@ export function route<C = unknown>(handler: Handler<C>): Handler<C> {
     } catch (err) {
       if (err instanceof HttpError) return json({ error: err.publicMessage }, err.status);
       if (err instanceof ZodError) return json({ error: 'invalid_request' }, 400);
-      return new Response(null, { status: 500 });
+      const errorId = `err_${randomUUID()}`;
+      logger.error('unhandled route error', { errorId, route: routeName(req), cause: safeCause(err) });
+      return json({ errorId }, 500);
     }
   };
 }
