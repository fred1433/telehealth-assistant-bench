+++ b/tests/patient-search.test.ts
@@ -0,0 +1,61 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/patients/search/route';
+import { call, TOKENS } from './helpers';
+
+const search = (token: string | undefined, q: unknown) =>
+  call(POST, { method: 'POST', path: '/api/patients/search', token, body: { q } });
+
+describe('POST /api/patients/search', () => {
+  afterEach(() => vi.restoreAllMocks());
+
+  it('matches first or last name, anywhere, case-insensitively', async () => {
+    const res = await search(TOKENS.rosa, 'LIND');
+    expect(res.status).toBe(200);
+    expect(res.json.results).toEqual([
+      { id: 'pt_ava', firstName: 'Ava', lastName: 'Lindqvist', dateOfBirth: expect.any(String) },
+    ]);
+    const mid = await search(TOKENS.rosa, 'archet');
+    expect(mid.json.results.map((r: { id: string }) => r.id)).toEqual(['pt_theo']);
+  });
+
+  it('returns only the allow-listed fields', async () => {
+    const res = await search(TOKENS.rosa, 'Ava');
+    expect(Object.keys(res.json.results[0]).sort()).toEqual(['dateOfBirth', 'firstName', 'id', 'lastName']);
+    expect(res.text).not.toContain('JH-000101');
+    expect(res.text).not.toContain('anxiety');
+    expect(res.text).not.toContain('@mail.example');
+  });
+
+  it('does not return patients of another practice or outside the care team', async () => {
+    expect((await search(TOKENS.rosa, 'June')).json.results).toEqual([]);
+    expect((await search(TOKENS.rosa, 'Priya')).json.results).toEqual([]);
+    expect((await search(TOKENS.hal, 'Ava')).json.results).toEqual([]);
+  });
+
+  it('treats LIKE wildcards literally', async () => {
+    expect((await search(TOKENS.rosa, '%%')).json.results).toEqual([]);
+    expect((await search(TOKENS.rosa, '__')).json.results).toEqual([]);
+  });
+
+  it('rejects short or malformed queries with 400', async () => {
+    expect((await search(TOKENS.rosa, 'a')).status).toBe(400);
+    expect((await search(TOKENS.rosa, ' a ')).status).toBe(400);
+    expect((await search(TOKENS.rosa, 42)).status).toBe(400);
+  });
+
+  it('is for practitioners only', async () => {
+    expect((await search(TOKENS.ava, 'Ava')).status).toBe(403);
+    expect((await search(TOKENS.dana, 'Ava')).status).toBe(403);
+    expect((await search(undefined, 'Ava')).status).toBe(401);
+  });
+
+  it('does not log the searched name or any patient name', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    await search(TOKENS.rosa, 'Lindqvist');
+    await search(TOKENS.rosa, 'a');
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    expect(logged).not.toContain('Lindqvist');
+    expect(logged).not.toContain('Marchetti');
+  });
+});
