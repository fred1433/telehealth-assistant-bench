diff --git a/src/lib/scheduleCache.ts b/src/lib/scheduleCache.ts
new file mode 100644
index 0000000..1a9cf2b
--- /dev/null
+++ b/src/lib/scheduleCache.ts
@@ -0,0 +1,39 @@
+import { getRedis, KEY_PREFIX } from './redis';
+
+/**
+ * Short-lived cache of a practitioner's day view. The key holds only the practitioner id
+ * (never a patient id). The value is the endpoint's response, which already excludes
+ * visit reasons, notes and reasons for care; it does contain patient names, so the TTL is short.
+ */
+const TTL_SECONDS = 60;
+
+const key = (practitionerId: string) => `${KEY_PREFIX}schedule:today:${practitionerId}`;
+
+export interface CachedDay {
+  day: string;
+  appointments: unknown[];
+}
+
+export async function getCachedDay(practitionerId: string, day: string): Promise<CachedDay | null> {
+  try {
+    const raw = await getRedis().get(key(practitionerId));
+    if (!raw) return null;
+    const v = JSON.parse(raw) as CachedDay;
+    return v.day === day ? v : null;
+  } catch {
+    return null;
+  }
+}
+
+export async function setCachedDay(practitionerId: string, value: CachedDay): Promise<void> {
+  try {
+    await getRedis().set(key(practitionerId), JSON.stringify(value), 'EX', TTL_SECONDS);
+  } catch {
+    // cache is best effort
+  }
+}
+
+/** Drop a practitioner's cached day view (e.g. after their access to a patient changes). */
+export async function invalidateDay(practitionerId: string): Promise<void> {
+  await getRedis().del(key(practitionerId));
+}
diff --git a/tests/scheduleCache.test.ts b/tests/scheduleCache.test.ts
new file mode 100644
index 0000000..274a23b
--- /dev/null
+++ b/tests/scheduleCache.test.ts
@@ -0,0 +1,48 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/practitioner/schedule/today/route';
+import { POST as REVOKE } from '@/app/api/admin/care-team/revoke/route';
+import { getRedis, KEY_PREFIX } from '@/lib/redis';
+import { call, TOKENS } from './helpers';
+
+const ids = (r: { json: any }) => r.json.appointments.map((a: { id: string }) => a.id);
+
+describe('day view cache', () => {
+  it('caches with a short TTL, no patient id or name in keys, no clinical content in values', async () => {
+    const redis = getRedis();
+    const first = await call(GET, { token: TOKENS.rosa });
+    expect(ids(first)).toEqual(['apt_001', 'apt_002']);
+
+    const keys = (await redis.keys(`${KEY_PREFIX}schedule:*`));
+    expect(keys.length).toBeGreaterThan(0);
+    for (const k of keys) {
+      expect(k).not.toMatch(/pt_|Ava|Theo/);
+      const ttl = await redis.ttl(k);
+      expect(ttl).toBeGreaterThan(0);
+      expect(ttl).toBeLessThanOrEqual(900);
+      const v = (await redis.get(k)) ?? '';
+      expect(v).not.toContain('Follow-up on sleep');
+      expect(v).not.toContain('Bring sleep diary');
+    }
+
+    const second = await call(GET, { token: TOKENS.rosa });
+    expect(second.json).toEqual(first.json);
+  });
+
+  it("does not show one practitioner another's day", async () => {
+    await call(GET, { token: TOKENS.rosa });
+    const malik = await call(GET, { token: TOKENS.malik });
+    expect(ids(malik)).toEqual(['apt_003']);
+  });
+
+  it('drops a patient from the cached view immediately after revoke', async () => {
+    await call(GET, { token: TOKENS.rosa });
+    const rev = await call(REVOKE, {
+      method: 'POST',
+      token: TOKENS.dana,
+      body: { practitionerId: 'pr_rosa', patientId: 'pt_theo' },
+    });
+    expect(rev.status).toBe(200);
+    const after = await call(GET, { token: TOKENS.rosa });
+    expect(ids(after)).toEqual(['apt_001']);
+  });
+});
