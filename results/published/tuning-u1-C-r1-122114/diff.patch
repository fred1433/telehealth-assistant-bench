+import { describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/appointments/[id]/cancel/route';
+import { mailOutbox } from '@/lib/mailer';
+import { query } from '@/lib/db';
+import { call, TOKENS } from './helpers';
+
+const cancel = (token: string | undefined, id: string) =>
+  call(POST, { method: 'POST', token, params: { id }, path: '/api/appointments/' + id + '/cancel' });
+const status = async (id: string) =>
+  (await query<{ status: string }>('SELECT status FROM appointments WHERE id = ?', [id]))[0].status;
+
+describe('POST /api/appointments/{id}/cancel', () => {
+  it('rejects unauthenticated, other patient, other practice, other practitioner, admin', async () => {
+    expect((await cancel(undefined, 'apt_001')).status).toBe(401);
+    for (const t of [TOKENS.theo, TOKENS.june, TOKENS.hal, TOKENS.malik, TOKENS.dana]) {
+      expect((await cancel(t, 'apt_001')).status).toBe(404);
+    }
+    expect((await cancel(TOKENS.rosa, 'apt_nope')).status).toBe(404);
+    expect(await status('apt_001')).toBe('booked');
+    expect(mailOutbox.length).toBe(0);
+  });
+
+  it('patient cancels; practitioner gets a generic email; nothing logged', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    const res = await cancel(TOKENS.ava, 'apt_001');
+    expect(res.status).toBe(200);
+    expect(res.json).toEqual({ id: 'apt_001', status: 'cancelled' });
+    expect(await status('apt_001')).toBe('cancelled');
+    expect(mailOutbox.length).toBe(1);
+    const mail = mailOutbox[0];
+    const rows = await query<{ visit_reason: string | null; notes: string | null; first_name: string; last_name: string; email: string }>(
+      "SELECT a.visit_reason, a.notes, p.first_name, p.last_name, p.email FROM appointments a JOIN patients p ON p.id = a.patient_id WHERE a.id = 'apt_001'",
+    );
+    const blob = JSON.stringify(mail);
+    for (const s of [rows[0].visit_reason, rows[0].notes, rows[0].first_name, rows[0].last_name, rows[0].email]) {
+      if (s) expect(blob).not.toContain(s);
+    }
+    expect(mail.to).not.toBe(rows[0].email);
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    expect(logged).not.toContain(rows[0].first_name);
+    expect(logged).not.toContain(rows[0].email);
+    out.mockRestore();
+    err.mockRestore();
+  });
+
+  it('is idempotent and sends no second email', async () => {
+    const n = mailOutbox.length;
+    expect((await cancel(TOKENS.ava, 'apt_001')).status).toBe(200);
+    expect(mailOutbox.length).toBe(n);
+  });
+
+  it('practitioner cancels; patient is emailed', async () => {
+    mailOutbox.length = 0;
+    const res = await cancel(TOKENS.rosa, 'apt_002');
+    expect(res.status).toBe(200);
+    expect(await status('apt_002')).toBe('cancelled');
+    expect(mailOutbox.length).toBe(1);
+    expect(mailOutbox[0].text).toContain('portal');
+  });
+});
