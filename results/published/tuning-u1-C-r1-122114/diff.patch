+export interface CancelTarget {
+  id: string;
+  org_id: string;
+  patient_id: string;
+  practitioner_id: string;
+  status: AppointmentRow['status'];
+}
+
+/** Minimal columns needed to authorize and cancel; no reason or notes. */
+export async function getCancelTarget(id: string): Promise<CancelTarget | null> {
+  return queryOne<CancelTarget>(
+    'SELECT id, org_id, patient_id, practitioner_id, status FROM appointments WHERE id = ?',
+    [id],
+  );
+}
+
+/** Marks a booked appointment cancelled. Returns false if it was not in 'booked' state. */
+export async function cancelBooked(id: string): Promise<boolean> {
+  const res = await execute("UPDATE appointments SET status = 'cancelled' WHERE id = ? AND status = 'booked'", [id]);
+  return res.affectedRows > 0;
+}
+
+/** Email addresses of an appointment's two parties (address only, nothing else). */
+export async function getPartyEmails(
+  patientId: string,
+  practitionerId: string,
+): Promise<{ patientEmail: string | null; practitionerEmail: string | null }> {
+  const row = await queryOne<{ patient_email: string | null; practitioner_email: string | null }>(
+    `SELECT p.email AS patient_email, u.email AS practitioner_email
+       FROM patients p, practitioners pr JOIN users u ON u.id = pr.user_id
+      WHERE p.id = ? AND pr.id = ?`,
+    [patientId, practitionerId],
+  );
+  return { patientEmail: row?.patient_email ?? null, practitionerEmail: row?.practitioner_email ?? null };
+}
