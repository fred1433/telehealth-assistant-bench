diff --git a/src/lib/dayViewCache.ts b/src/lib/dayViewCache.ts
new file mode 100644
index 0000000..54d1967
--- /dev/null
+++ b/src/lib/dayViewCache.ts
@@ -0,0 +1,26 @@
+import { getRedis, KEY_PREFIX } from './redis';
+
+const TTL_SECONDS = 15 * 60;
+
+// Keys use only the practitioner id and the day (no patient ids). A per-practitioner
+// version counter lets revocation invalidate in-flight cache fills too.
+const verKey = (practitionerId: string) => `${KEY_PREFIX}dayview:ver:${practitionerId}`;
+const dataKey = (practitionerId: string, ver: string, day: string) =>
+  `${KEY_PREFIX}dayview:${practitionerId}:${ver}:${day}`;
+
+export async function getDayView<T>(practitionerId: string, day: string): Promise<{ hit: T | null; ver: string }> {
+  const redis = getRedis();
+  const ver = (await redis.get(verKey(practitionerId))) ?? '0';
+  const raw = await redis.get(dataKey(practitionerId, ver, day));
+  return { hit: raw ? (JSON.parse(raw) as T) : null, ver };
+}
+
+export async function setDayView(practitionerId: string, day: string, ver: string, value: unknown): Promise<void> {
+  await getRedis().set(dataKey(practitionerId, ver, day), JSON.stringify(value), 'EX', TTL_SECONDS);
+}
+
+/** Invalidates all cached day views of a practitioner (e.g. after losing access to a patient). */
+export async function invalidateDayView(practitionerId: string): Promise<void> {
+  const redis = getRedis();
+  await redis.multi().incr(verKey(practitionerId)).expire(verKey(practitionerId), TTL_SECONDS).exec();
+}
