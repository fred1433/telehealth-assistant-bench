+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { logger } from '@/lib/logger';
+import { sendMail } from '@/lib/mailer';
+import { env } from '@/lib/env';
+import { hasActiveAccess } from '@/repos/careTeam';
+import { getUser } from '@/repos/users';
+import { getCancelContext, markCancelled } from '@/repos/appointments';
+
+type Ctx = { params: Promise<{ id: string }> };
+
+/** The appointment's patient or practitioner cancels it; everyone else gets 404. */
+export const POST = route<Ctx>(async (req, { params }) => {
+  const user = await requireUser(req);
+  const { id } = await params;
+  const appt = await getCancelContext(id);
+
+  const isPatient = user.role === 'patient' && !!user.patientId && appt?.patient_id === user.patientId;
+  const isPractitioner =
+    user.role === 'practitioner' && !!user.practitionerId && appt?.practitioner_id === user.practitionerId;
+  if (!appt || appt.org_id !== user.orgId || !(isPatient || isPractitioner)) throw new HttpError(404, 'not_found');
+  if (isPractitioner && !(await hasActiveAccess(appt.practitioner_id, appt.patient_id))) {
+    throw new HttpError(404, 'not_found');
+  }
+
+  if (appt.status === 'completed') throw new HttpError(409, 'not_cancellable');
+
+  // Only the request that flips booked -> cancelled notifies; repeats are idempotent and silent.
+  if (await markCancelled(appt.id)) {
+    await audit(user, 'appointment.cancel', 'appointment', appt.id);
+    const otherUserId = isPatient ? appt.practitioner_user_id : appt.patient_user_id;
+    try {
+      const other = otherUserId ? await getUser(otherUserId) : null;
+      if (other) {
+        await sendMail({
+          to: other.email,
+          subject: 'An appointment was cancelled',
+          text: `An appointment was cancelled. Details are in the portal: ${env.appBaseUrl}`,
+        });
+      }
+    } catch (err) {
+      const code = (err as { code?: unknown } | null)?.code;
+      logger.error('appointment cancel notification failed', {
+        appointmentId: appt.id,
+        code: typeof code === 'string' ? code : undefined,
+      });
+    }
+  }
+  return json({ id: appt.id, status: 'cancelled' });
+});
