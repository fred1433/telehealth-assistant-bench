+export interface CancelContext {
+  id: string;
+  org_id: string;
+  patient_id: string;
+  practitioner_id: string;
+  status: AppointmentRow['status'];
+  patient_user_id: string | null;
+  practitioner_user_id: string;
+}
+
+/** Only the columns needed to authorize and route a cancellation (no reason, notes or names). */
+export async function getCancelContext(id: string): Promise<CancelContext | null> {
+  const rows = await query<CancelContext>(
+    `SELECT a.id, a.org_id, a.patient_id, a.practitioner_id, a.status,
+            p.user_id AS patient_user_id, pr.user_id AS practitioner_user_id
+       FROM appointments a
+       JOIN patients p ON p.id = a.patient_id
+       JOIN practitioners pr ON pr.id = a.practitioner_id
+      WHERE a.id = ?`,
+    [id],
+  );
+  return rows[0] ?? null;
+}
+
+/** Marks a booked appointment cancelled. Returns false if it was not in the booked state. */
+export async function markCancelled(id: string): Promise<boolean> {
+  const res = await execute("UPDATE appointments SET status = 'cancelled' WHERE id = ? AND status = 'booked'", [id]);
+  return res.affectedRows > 0;
+}
