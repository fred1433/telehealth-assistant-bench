+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/appointments/[id]/cancel/route';
+import { mailOutbox } from '@/lib/mailer';
+import { call, TOKENS } from './helpers';
+
+const cancel = (id: string, token?: string) =>
+  call(POST, { method: 'POST', path: `/api/appointments/${id}/cancel`, token, params: { id } });
+
+afterEach(() => vi.restoreAllMocks());
+
+describe('POST /api/appointments/{id}/cancel', () => {
+  it('rejects unauthenticated callers', async () => {
+    expect((await cancel('apt_002')).status).toBe(401);
+  });
+
+  it('404s for other patients, other practitioners, other practice, admin, unknown id', async () => {
+    for (const t of [TOKENS.theo, TOKENS.malik, TOKENS.hal, TOKENS.june, TOKENS.dana]) {
+      expect((await cancel('apt_001', t)).status).toBe(404);
+    }
+    expect((await cancel('apt_nope', TOKENS.ava)).status).toBe(404);
+    expect(mailOutbox).toHaveLength(0);
+  });
+
+  it('patient cancels: practitioner gets a generic email, no PHI anywhere', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const errw = vi.spyOn(process.stderr, 'write');
+    const res = await cancel('apt_001', TOKENS.ava);
+    expect(res.status).toBe(200);
+    expect(res.json).toEqual({ id: 'apt_001', status: 'cancelled' });
+    expect(mailOutbox).toHaveLength(1);
+    const mail = JSON.stringify(mailOutbox[0]);
+    expect(mailOutbox[0].to).toMatch(/rosa/i);
+    expect(mail).toMatch(/portal/i);
+    for (const bad of ['Ava', 'sleep', 'anxiety', 'diary', 'Follow-up']) expect(mail).not.toContain(bad);
+    const logs = [...out.mock.calls, ...errw.mock.calls].map((c) => String(c[0])).join('');
+    expect(logs).not.toMatch(/sleep|anxiety|@/);
+  });
+
+  it('is idempotent and does not re-send', async () => {
+    mailOutbox.length = 0;
+    const res = await cancel('apt_001', TOKENS.ava);
+    expect(res.status).toBe(200);
+    expect(mailOutbox).toHaveLength(0);
+  });
+
+  it('practitioner cancels: patient is emailed without the practitioner or patient name', async () => {
+    mailOutbox.length = 0;
+    const res = await cancel('apt_002', TOKENS.rosa);
+    expect(res.status).toBe(200);
+    expect(res.json).toEqual({ id: 'apt_002', status: 'cancelled' });
+    expect(mailOutbox).toHaveLength(1);
+    const mail = JSON.stringify(mailOutbox[0]);
+    for (const bad of ['Theo', 'Rosa', 'Relapse']) expect(mail).not.toContain(bad);
+  });
+});
