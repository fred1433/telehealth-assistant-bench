@@ -0,0 +1,39 @@
+import { describe, expect, it } from 'vitest';
+import { POST } from '@/app/api/messages/route';
+import { GET as inbox } from '@/app/api/messages/route';
+import { GET } from '@/app/api/messages/[id]/route';
+import { call, TOKENS } from './helpers';
+
+async function send(): Promise<string> {
+  const res = await call(POST, {
+    method: 'POST',
+    token: TOKENS.rosa,
+    body: { recipientUserId: 'usr_ava', patientId: 'pt_ava', subject: 'Hello', body: 'Secret body' },
+  });
+  return res.json.id;
+}
+
+describe('GET /api/messages/{id}', () => {
+  it('returns exact shape to recipient and marks read', async () => {
+    const id = await send();
+    const res = await call(GET, { token: TOKENS.ava, params: { id } });
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.json).sort()).toEqual(['body', 'from', 'id', 'sentAt', 'subject']);
+    expect(Object.keys(res.json.from)).toEqual(['name']);
+    const list = await call(inbox, { token: TOKENS.ava });
+    expect(list.json.messages.find((m: any) => m.id === id).read).toBe(true);
+  });
+
+  it('404s for sender, admin, other patient, other practice, unknown id', async () => {
+    const id = await send();
+    for (const token of [TOKENS.rosa, TOKENS.dana, TOKENS.theo, TOKENS.hal, TOKENS.june]) {
+      expect((await call(GET, { token, params: { id } })).status).toBe(404);
+    }
+    expect((await call(GET, { token: TOKENS.ava, params: { id: 'msg_nope' } })).status).toBe(404);
+  });
+
+  it('requires authentication', async () => {
+    const id = await send();
+    expect((await call(GET, { params: { id } })).status).toBe(401);
+  });
+});
