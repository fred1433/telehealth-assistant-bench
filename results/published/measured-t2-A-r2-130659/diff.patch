+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { getMessageForRecipient, markRead } from '@/repos/messages';
+
+/** Opens a message; only its recipient may read it (everyone else gets 404). */
+export const GET = route<{ params: Promise<{ id: string }> }>(async (req, ctx) => {
+  const user = await requireUser(req);
+  const { id } = await ctx.params;
+  const msg = await getMessageForRecipient(id, user.id, user.orgId);
+  if (!msg) throw new HttpError(404, 'not_found');
+  await markRead(msg.id);
+  await audit(user, 'message.read', 'message', msg.id);
+  return json({
+    id: msg.id,
+    subject: msg.subject,
+    body: msg.body,
+    sentAt: msg.created_at,
+    from: { name: msg.sender_name },
+  });
+});
