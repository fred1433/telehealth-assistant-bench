@@ -65,6 +65,20 @@ export async function getMessage(messageId: string): Promise<MessageRow | null>
   return queryOne<MessageRow>('SELECT * FROM messages WHERE id = ?', [messageId]);
 }
 
+/** Message with sender display name, only if `userId` (in `orgId`) is its recipient. */
+export async function getMessageForRecipient(
+  messageId: string,
+  userId: string,
+  orgId: string,
+): Promise<{ id: string; subject: string; body: string; created_at: Date; sender_name: string } | null> {
+  return queryOne(
+    `SELECT m.id, m.subject, m.body, m.created_at, u.display_name AS sender_name
+       FROM messages m JOIN users u ON u.id = m.sender_user_id
+      WHERE m.id = ? AND m.recipient_user_id = ? AND m.org_id = ?`,
+    [messageId, userId, orgId],
+  );
+}
+
 export async function markRead(messageId: string): Promise<void> {
   await execute('UPDATE messages SET read_at = UTC_TIMESTAMP(3) WHERE id = ? AND read_at IS NULL', [messageId]);
 }
