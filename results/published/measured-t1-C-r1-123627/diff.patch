diff --git a/tests/message-notify.test.ts b/tests/message-notify.test.ts
new file mode 100644
index 0000000..a8ae8e7
--- /dev/null
+++ b/tests/message-notify.test.ts
@@ -0,0 +1,48 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/messages/route';
+import { mailOutbox } from '@/lib/mailer';
+import * as pushLib from '@/lib/push';
+import { call, TOKENS } from './helpers';
+
+const SUBJECT = 'Zebra-subject-xyz';
+const BODY = 'Quokka-body-xyz';
+
+function send() {
+  return call(POST, {
+    method: 'POST',
+    token: TOKENS.rosa,
+    body: { recipientUserId: 'usr_ava', patientId: 'pt_ava', subject: SUBJECT, body: BODY },
+  });
+}
+
+describe('message notifications', () => {
+  beforeEach(() => {
+    mailOutbox.length = 0;
+    pushLib.pushOutbox.length = 0;
+  });
+
+  it('sends one generic email and one push per device', async () => {
+    const res = await send();
+    expect(res.status).toBe(201);
+    expect(mailOutbox).toHaveLength(1);
+    expect(mailOutbox[0].to).toBe('ava.lindqvist@mail.example');
+    expect(pushLib.pushOutbox.map((p) => p.token).sort()).toEqual(['fcm-dev-ava-phone', 'fcm-dev-ava-tablet']);
+    const all = JSON.stringify([mailOutbox, pushLib.pushOutbox]);
+    for (const s of [SUBJECT, BODY, 'Ava', 'Lindqvist', 'Generalized', 'anxiety']) expect(all).not.toContain(s);
+    expect(mailOutbox[0].text).toContain('http');
+  });
+
+  it('still answers 201 when push fails, without logging PHI', async () => {
+    const spy = vi.spyOn(pushLib, 'sendPush').mockRejectedValue(new Error('boom ava.lindqvist@mail.example'));
+    const out = vi.spyOn(process.stdout, 'write');
+    const errw = vi.spyOn(process.stderr, 'write');
+    const res = await send();
+    const logged = [...out.mock.calls, ...errw.mock.calls].map((c) => String(c[0])).join('');
+    spy.mockRestore();
+    out.mockRestore();
+    errw.mockRestore();
+    expect(res.status).toBe(201);
+    expect(logged).not.toContain('ava.lindqvist');
+    expect(logged).not.toContain(SUBJECT);
+  });
+});
