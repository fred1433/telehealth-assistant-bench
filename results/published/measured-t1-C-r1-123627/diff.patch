+function errCode(e: unknown): string {
+  const code = (e as { code?: unknown } | null)?.code;
+  return typeof code === 'string' ? code : 'unknown';
+}
+
+/** Generic notifications only: no subject, body, names or reasons. Never throws. */
+async function notifyRecipient(messageId: string, recipientId: string, email: string): Promise<void> {
+  try {
+    await sendMail({
+      to: email,
+      subject: 'You have a new secure message',
+      text: `A new secure message is waiting for you. Please sign in to the portal to read it: ${env.appBaseUrl}`,
+    });
+  } catch (e) {
+    const code = errCode(e);
+    logger.error('message email failed', { messageId, recipientId, code });
+  }
+  let tokens: string[] = [];
+  try {
+    tokens = await listPushTokens(recipientId);
+  } catch (e) {
+    const code = errCode(e);
+    logger.error('message push token lookup failed', { messageId, recipientId, code });
+  }
+  for (const token of tokens) {
+    try {
+      await sendPush({
+        token,
+        notification: { title: 'New secure message', body: 'A new secure message is waiting. Sign in to read it.' },
+        data: { type: 'secure_message' },
+      });
+    } catch (e) {
+      const code = errCode(e);
+      logger.error('message push failed', { messageId, recipientId, code });
+    }
+  }
+}
