@@ -0,0 +1,21 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/me/export/route';
+import { call, TOKENS } from './helpers';
+
+describe('GET /api/me/export', () => {
+  it('exports the general record without psychotherapy notes', async () => {
+    const res = await call(GET, { token: TOKENS.ava });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_ava');
+    expect(res.json.patient.mrn).toBeTruthy();
+    expect(res.json.clinicalNotes).toHaveLength(2);
+    expect(Object.keys(res.json).sort()).toEqual(['appointments', 'clinicalNotes', 'messages', 'patient']);
+    for (const m of res.json.messages) expect(['sent', 'received']).toContain(m.direction);
+  });
+
+  it('is for patients only', async () => {
+    expect((await call(GET, { token: TOKENS.rosa })).status).toBe(403);
+    expect((await call(GET, { token: TOKENS.dana })).status).toBe(403);
+    expect((await call(GET, {})).status).toBe(401);
+  });
+});
