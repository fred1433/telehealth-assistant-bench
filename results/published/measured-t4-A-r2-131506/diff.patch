diff --git a/src/lib/dayViewCache.ts b/src/lib/dayViewCache.ts
new file mode 100644
index 0000000..56c7931
--- /dev/null
+++ b/src/lib/dayViewCache.ts
@@ -0,0 +1,13 @@
+import { getRedis, KEY_PREFIX } from './redis';
+
+/** Day-view cache lifetime; well under the 15 minute ceiling. */
+export const DAY_VIEW_TTL_SECONDS = 300;
+
+/** Keyed by practitioner id only (no patient identifiers); the cached value carries its day. */
+export function dayViewKey(practitionerId: string): string {
+  return `${KEY_PREFIX}dayview:${practitionerId}`;
+}
+
+export async function invalidateDayView(practitionerId: string): Promise<void> {
+  await getRedis().del(dayViewKey(practitionerId));
+}
