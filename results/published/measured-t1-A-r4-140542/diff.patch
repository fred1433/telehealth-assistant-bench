+++ b/src/lib/notify.ts
@@ -0,0 +1,36 @@
+import { env } from './env';
+import { logger } from './logger';
+import { sendMail } from './mailer';
+import { sendPush } from './push';
+import { listPushTokens } from '@/repos/devices';
+
+/**
+ * Tells a user a secure message is waiting. Content is deliberately generic (no PHI).
+ * Never throws: failures are logged with ids only.
+ */
+export async function notifyNewSecureMessage(recipient: { id: string; email: string }, messageId: string): Promise<void> {
+  try {
+    await sendMail({
+      to: recipient.email,
+      subject: 'You have a new secure message',
+      text: `A new secure message is waiting for you. Please sign in to read it: ${env.appBaseUrl}`,
+    });
+  } catch {
+    logger.warn('message email notification failed', { messageId, recipientId: recipient.id });
+  }
+  try {
+    const tokens = await listPushTokens(recipient.id);
+    for (const token of tokens) {
+      try {
+        await sendPush({
+          token,
+          notification: { title: 'New secure message', body: 'A new secure message is waiting. Sign in to read it.' },
+        });
+      } catch {
+        logger.warn('message push notification failed', { messageId, recipientId: recipient.id });
+      }
+    }
+  } catch {
+    logger.warn('message push lookup failed', { messageId, recipientId: recipient.id });
+  }
+}
