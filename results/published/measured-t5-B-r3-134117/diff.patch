@@ -1,5 +1,7 @@
 import { NextResponse } from 'next/server';
 import { ZodError } from 'zod';
+import { logger } from './logger';
+import { newId } from './ids';
 
 export class HttpError extends Error {
   constructor(public readonly status: number, public readonly publicMessage: string) {
@@ -24,7 +26,26 @@ export function route<C = unknown>(handler: Handler<C>): Handler<C> {
     } catch (err) {
       if (err instanceof HttpError) return json({ error: err.publicMessage }, err.status);
       if (err instanceof ZodError) return json({ error: 'invalid_request' }, 400);
-      return new Response(null, { status: 500 });
+      const errorId = newId('err');
+      // Only the path (no query string), error name and driver code: never the message,
+      // `sql` or `sqlMessage`, which can contain bound patient values.
+      let path = 'unknown';
+      try {
+        path = new URL(req.url).pathname;
+      } catch {
+        /* keep default */
+      }
+      const e = err as { name?: unknown; code?: unknown } | null;
+      const cause = {
+        name: typeof e?.name === 'string' ? e.name : 'unknown',
+        code: typeof e?.code === 'string' ? e.code : undefined,
+      };
+      try {
+        logger.error('unhandled route error', { errorId, route: `${req.method} ${path}`, cause });
+      } catch {
+        /* logging must not mask the response */
+      }
+      return json({ errorId }, 500);
     }
   };
 }
