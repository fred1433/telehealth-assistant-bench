diff --git a/tests/booking.test.ts b/tests/booking.test.ts
new file mode 100644
index 0000000..05bdbf0
--- /dev/null
+++ b/tests/booking.test.ts
@@ -0,0 +1,49 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/appointments/route';
+import * as appts from '@/repos/appointments';
+import { call, TOKENS } from './helpers';
+
+const REASON = 'zzdistinctivereason';
+const body = {
+  practitionerId: 'pr_rosa',
+  startsAt: '2030-01-01T10:00:00.000Z',
+  endsAt: '2030-01-01T10:30:00.000Z',
+  visitReason: REASON,
+};
+
+afterEach(() => vi.restoreAllMocks());
+
+describe('POST /api/appointments', () => {
+  it('books and returns the new id', async () => {
+    const res = await call(POST, { method: 'POST', token: TOKENS.ava, body });
+    expect(res.status).toBe(201);
+    expect(res.json.id).toMatch(/^apt_/);
+  });
+
+  it('rejects other roles and unauthenticated callers', async () => {
+    expect((await call(POST, { method: 'POST', token: TOKENS.rosa, body })).status).toBe(403);
+    expect((await call(POST, { method: 'POST', body })).status).toBe(401);
+  });
+
+  it('returns an errorId and logs a PHI-free line on unexpected failure', async () => {
+    const err = Object.assign(new Error(`Duplicate entry 'ava@x' ${REASON}`), {
+      code: 'ER_DUP_ENTRY',
+      sql: `INSERT ... '${REASON}'`,
+      sqlMessage: `Duplicate entry '${REASON}'`,
+    });
+    vi.spyOn(appts, 'createAppointment').mockRejectedValue(err);
+    const out = vi.spyOn(process.stdout, 'write');
+    const errw = vi.spyOn(process.stderr, 'write');
+    const res = await call(POST, { method: 'POST', path: '/api/appointments', token: TOKENS.ava, body });
+    expect(res.status).toBe(500);
+    expect(Object.keys(res.json)).toEqual(['errorId']);
+    const logged = [...out.mock.calls, ...errw.mock.calls].map((c) => String(c[0])).join('');
+    expect(logged).toContain(res.json.errorId);
+    expect(logged).toContain('/api/appointments');
+    expect(logged).toContain('ER_DUP_ENTRY');
+    for (const s of [REASON, 'ava@', 'INSERT', 'Duplicate']) {
+      expect(logged).not.toContain(s);
+      expect(res.text).not.toContain(s);
+    }
+  });
+});
