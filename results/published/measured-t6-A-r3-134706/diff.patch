+import { z } from 'zod';
+import { requireUser } from '@/lib/auth';
+import { json, route, readJson, HttpError } from '@/lib/http';
+import { searchByName } from '@/repos/patients';
+
+const Body = z.object({ q: z.string().trim().min(2).max(100) });
+
+/**
+ * Patient name search for practitioners. POST with a JSON body (not GET) so the
+ * searched name never appears in the URL / Apache access log.
+ */
+export const POST = route(async (req) => {
+  const user = await requireUser(req);
+  if (user.role !== 'practitioner' || !user.practitionerId) throw new HttpError(403, 'forbidden');
+  const { q } = Body.parse(await readJson(req));
+  const rows = await searchByName(user.orgId, q);
+  return json({
+    results: rows.map((p) => ({
+      id: p.id,
+      firstName: p.first_name,
+      lastName: p.last_name,
+      dateOfBirth: p.date_of_birth,
+    })),
+  });
+});
