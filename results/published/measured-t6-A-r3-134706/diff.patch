+export interface PatientSearchRow {
+  id: string;
+  first_name: string;
+  last_name: string;
+  date_of_birth: Date;
+}
+
+/** Case-insensitive substring match on first/last name within one practice (max 20). */
+export async function searchByName(orgId: string, fragment: string): Promise<PatientSearchRow[]> {
+  const escaped = fragment.replace(/[\\%_]/g, '\\$&');
+  const like = `%${escaped}%`;
+  return query<PatientSearchRow>(
+    'SELECT id, first_name, last_name, date_of_birth FROM patients ' +
+      'WHERE org_id = ? AND (first_name LIKE ? OR last_name LIKE ?) ORDER BY last_name, first_name, id LIMIT 20',
+    [orgId, like, like],
+  );
+}
+
 export async function getPatientByUserId(userId: string): Promise<PatientRow | null> {
   return queryOne<PatientRow>('SELECT * FROM patients WHERE user_id = ?', [userId]);
 }
