+/** Messages a user sent or received, for their own export. Explicit columns only. */
+export async function listForUserExport(
+  userId: string,
+): Promise<Array<{ id: string; subject: string; body: string; created_at: Date; direction: 'sent' | 'received' }>> {
+  return query(
+    `SELECT id, subject, body, created_at,
+            CASE WHEN sender_user_id = ? THEN 'sent' ELSE 'received' END AS direction
+       FROM messages
+      WHERE sender_user_id = ? OR recipient_user_id = ?
+      ORDER BY created_at`,
+    [userId, userId, userId],
+  );
+}
