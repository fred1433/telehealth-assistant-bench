+/** A patient's own appointments for export: no practitioner notes. */
+export async function listExportForPatient(
+  patientId: string,
+): Promise<Array<{ id: string; starts_at: Date; ends_at: Date; status: string; visit_reason: string | null }>> {
+  return query(
+    'SELECT id, starts_at, ends_at, status, visit_reason FROM appointments WHERE patient_id = ? ORDER BY starts_at',
+    [patientId],
+  );
+}
