@@ -0,0 +1,50 @@
+import { describe, expect, it, vi } from 'vitest';
+import { GET } from '@/app/api/me/export/route';
+import { call, TOKENS } from './helpers';
+
+describe('GET /api/me/export', () => {
+  it('exports the patient own general record only', async () => {
+    const res = await call(GET, { token: TOKENS.ava, path: '/api/me/export' });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_ava');
+    expect(res.json.patient.mrn).toBeTruthy();
+    expect(res.json.clinicalNotes.map((n: any) => n.id).sort()).toEqual(['cn_001', 'cn_002']);
+    expect(res.json.messages.map((m: any) => [m.id, m.direction]).sort()).toEqual([
+      ['msg_001', 'received'],
+      ['msg_002', 'sent'],
+    ]);
+    expect(res.json.appointments.map((a: any) => a.id)).toEqual(expect.arrayContaining(['apt_001', 'apt_004']));
+    expect(res.text).not.toContain('Process notes');
+    expect(res.text).not.toContain('pn_001');
+    expect(res.text).not.toContain('Bring sleep diary');
+    expect(res.text).not.toContain('Relapse prevention');
+    expect(res.text).not.toContain('shame');
+  });
+
+  it('does not leak another patient record', async () => {
+    const res = await call(GET, { token: TOKENS.theo });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_theo');
+    expect(res.text).not.toContain('Before Thursday');
+    expect(res.text).not.toContain('Intake assessment');
+    expect(res.json.clinicalNotes.map((n: any) => n.id)).toEqual(['cn_003']);
+  });
+
+  it('refuses other roles and unauthenticated callers', async () => {
+    for (const t of [TOKENS.rosa, TOKENS.dana, TOKENS.hal]) {
+      expect((await call(GET, { token: t })).status).toBe(403);
+    }
+    expect((await call(GET)).status).toBe(401);
+  });
+
+  it('logs nothing from the record', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    await call(GET, { token: TOKENS.ava });
+    const logged = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    out.mockRestore();
+    err.mockRestore();
+    expect(logged).not.toContain('Ava');
+    expect(logged).not.toContain('sleep');
+  });
+});
