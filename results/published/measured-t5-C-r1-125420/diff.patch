 export class HttpError extends Error {
   constructor(public readonly status: number, public readonly publicMessage: string) {
@@ -17,13 +19,34 @@ type Handler<C> = (req: Request, ctx: C) => Promise<Response>;
  * Wraps a route handler: known HttpErrors become JSON `{ error }` responses,
  * validation errors become 400, anything else becomes a 500.
  */
-export function route<C = unknown>(handler: Handler<C>): Handler<C> {
+export function route<C = unknown>(handler: Handler<C>, routeName?: string): Handler<C> {
   return async (req, ctx) => {
     try {
       return await handler(req, ctx);
     } catch (err) {
       if (err instanceof HttpError) return json({ error: err.publicMessage }, err.status);
       if (err instanceof ZodError) return json({ error: 'invalid_request' }, 400);
+      if (routeName) {
+        // Only non-PHI parts of the error: never message/sql/sqlMessage, which can hold bound values.
+        const errorId = newId('err');
+        const e = (err ?? {}) as { code?: unknown; errno?: unknown; sqlState?: unknown };
+        const str = (v: unknown) => (typeof v === 'string' || typeof v === 'number' ? v : undefined);
+        try {
+          logger.error('unhandled route error', {
+            errorId,
+            route: routeName,
+            cause: {
+              name: err instanceof Error ? err.name : typeof err,
+              code: str(e.code),
+              errno: str(e.errno),
+              sqlState: str(e.sqlState),
+            },
+          });
+        } catch {
+          // logging must never mask the response
+        }
+        return json({ errorId }, 500);
+      }
       return new Response(null, { status: 500 });
     }
   };
