diff --git a/tests/appointments-book.test.ts b/tests/appointments-book.test.ts
new file mode 100644
index 0000000..8dc828b
--- /dev/null
+++ b/tests/appointments-book.test.ts
@@ -0,0 +1,52 @@
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/appointments/route';
+import * as repo from '@/repos/appointments';
+import { call, TOKENS } from './helpers';
+
+const REASON = 'zzq-private-visit-reason';
+const body = {
+  practitionerId: 'pr_rosa',
+  startsAt: '2030-01-02T10:00:00.000Z',
+  endsAt: '2030-01-02T10:30:00.000Z',
+  visitReason: REASON,
+};
+
+afterEach(() => vi.restoreAllMocks());
+
+describe('POST /api/appointments', () => {
+  it('books and returns the new id', async () => {
+    const res = await call(POST, { method: 'POST', token: TOKENS.ava, body });
+    expect(res.status).toBe(201);
+    expect(res.json.id).toMatch(/^apt_/);
+  });
+
+  it('rejects unauthenticated, other patients of the care team, and other practices', async () => {
+    expect((await call(POST, { method: 'POST', body })).status).toBe(401);
+    expect((await call(POST, { method: 'POST', token: TOKENS.priya, body })).status).toBe(403);
+    expect((await call(POST, { method: 'POST', token: TOKENS.june, body })).status).toBe(404);
+    expect((await call(POST, { method: 'POST', token: TOKENS.rosa, body })).status).toBe(403);
+  });
+
+  it('returns an errorId and logs id, route and cause without PHI on unexpected failure', async () => {
+    const out = vi.spyOn(process.stdout, 'write');
+    const errOut = vi.spyOn(process.stderr, 'write');
+    const failure = Object.assign(new Error(`Duplicate entry '${REASON}' sql INSERT ${REASON}`), {
+      code: 'ER_DUP_ENTRY',
+      sql: `INSERT ... '${REASON}'`,
+      sqlMessage: `Duplicate entry '${REASON}'`,
+    });
+    vi.spyOn(repo, 'createAppointment').mockRejectedValue(failure);
+
+    const res = await call(POST, { method: 'POST', token: TOKENS.ava, body });
+    expect(res.status).toBe(500);
+    expect(Object.keys(res.json)).toEqual(['errorId']);
+    expect(res.text).not.toContain(REASON);
+
+    const logged = [...out.mock.calls, ...errOut.mock.calls].map((c) => String(c[0])).join('');
+    expect(logged).toContain(res.json.errorId);
+    expect(logged).toContain('/api/appointments');
+    expect(logged).toContain('ER_DUP_ENTRY');
+    expect(logged).not.toContain(REASON);
+    expect(logged).not.toMatch(/INSERT|sqlMessage/);
+  });
+});
