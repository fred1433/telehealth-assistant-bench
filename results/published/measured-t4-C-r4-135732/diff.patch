+import { POST as REVOKE } from '@/app/api/admin/care-team/revoke/route';
+import { getRedis, KEY_PREFIX } from '@/lib/redis';
 import { call, TOKENS } from './helpers';
 
 describe('GET /api/practitioner/schedule/today', () => {
@@ -21,3 +23,30 @@ describe('GET /api/practitioner/schedule/today', () => {
     expect(res.status).toBe(403);
   });
 });
+
+describe('day view cache', () => {
+  it('keeps patient ids out of keys, bounds TTL, and is per practitioner', async () => {
+    await call(GET, { token: TOKENS.rosa });
+    await call(GET, { token: TOKENS.malik });
+    const keys = await getRedis().keys(`${KEY_PREFIX}sched:*`);
+    expect(keys.length).toBe(2);
+    for (const k of keys) {
+      expect(k).not.toMatch(/pt_/);
+      const ttl = await getRedis().ttl(k);
+      expect(ttl).toBeGreaterThan(0);
+      expect(ttl).toBeLessThanOrEqual(900);
+      expect(await getRedis().get(k)).not.toContain('Follow-up on sleep');
+    }
+    const malik = await call(GET, { token: TOKENS.malik });
+    expect(malik.json.appointments.map((a: { id: string }) => a.id)).toEqual(['apt_003']);
+  });
+
+  it('drops a revoked patient on the next call', async () => {
+    const before = await call(GET, { token: TOKENS.rosa });
+    expect(before.json.appointments.map((a: { id: string }) => a.id)).toContain('apt_002');
+    const rev = await call(REVOKE, { method: 'POST', token: TOKENS.dana, body: { practitionerId: 'pr_rosa', patientId: 'pt_theo' } });
+    expect(rev.status).toBe(200);
+    const after = await call(GET, { token: TOKENS.rosa });
+    expect(after.json.appointments.map((a: { id: string }) => a.id)).toEqual(['apt_001']);
+  });
+});
