diff --git a/src/lib/scheduleCache.ts b/src/lib/scheduleCache.ts
new file mode 100644
index 0000000..2fa419b
--- /dev/null
+++ b/src/lib/scheduleCache.ts
@@ -0,0 +1,30 @@
+import { getRedis, KEY_PREFIX } from './redis';
+
+/** Short TTL: the cached day view holds patient names, so keep it brief (max allowed is 15 min). */
+export const SCHEDULE_TTL_SECONDS = 60;
+
+/** Key holds only the practitioner id and the day: no patient identifiers. */
+function key(practitionerId: string, day: string): string {
+  return `${KEY_PREFIX}sched:today:${practitionerId}:${day}`;
+}
+
+export async function getCachedDay(practitionerId: string, day: string): Promise<string | null> {
+  try {
+    return await getRedis().get(key(practitionerId, day));
+  } catch {
+    return null;
+  }
+}
+
+export async function setCachedDay(practitionerId: string, day: string, payload: string): Promise<void> {
+  try {
+    await getRedis().set(key(practitionerId, day), payload, 'EX', SCHEDULE_TTL_SECONDS);
+  } catch {
+    /* cache is best effort */
+  }
+}
+
+/** Drops the practitioner's cached day view (today and tomorrow's UTC keys, covering a midnight rollover). */
+export async function invalidateDay(practitionerId: string, days: string[]): Promise<void> {
+  await getRedis().del(...days.map((d) => key(practitionerId, d)));
+}
