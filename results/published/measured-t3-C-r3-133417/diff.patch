+++ b/tests/export.test.ts
@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/me/export/route';
+import { call, TOKENS } from './helpers';
+
+describe('GET /api/me/export', () => {
+  it("exports the patient's own general record only", async () => {
+    const res = await call(GET, { token: TOKENS.ava });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_ava');
+    expect(res.json.patient.mrn).toBeTruthy();
+    expect(res.json.appointments.map((a: any) => a.id).sort()).toEqual(['apt_001', 'apt_004']);
+    expect(res.json.clinicalNotes.map((n: any) => n.id).sort()).toEqual(['cn_001', 'cn_002']);
+    const dirs = Object.fromEntries(res.json.messages.map((m: any) => [m.id, m.direction]));
+    expect(dirs).toEqual({ msg_001: 'received', msg_002: 'sent' });
+    expect(res.text).not.toContain('transference');
+    expect(res.text).not.toContain('pn_001');
+    expect(res.text).not.toContain('Bring sleep diary');
+    expect(res.text).not.toContain('abstinent');
+  });
+
+  it("does not leak another patient's data", async () => {
+    const res = await call(GET, { token: TOKENS.june });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_june');
+    expect(res.json.clinicalNotes).toEqual([]);
+    expect(res.text).not.toContain('pt_ava');
+  });
+
+  it.each(['rosa', 'dana', 'hal'] as const)('refuses %s with 403', async (who) => {
+    expect((await call(GET, { token: TOKENS[who] })).status).toBe(403);
+  });
+
+  it('requires authentication', async () => {
+    expect((await call(GET)).status).toBe(401);
+  });
+});
