+import { audit } from '@/lib/audit';
+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import * as appointments from '@/repos/appointments';
+import * as messages from '@/repos/messages';
+import * as notes from '@/repos/notes';
+import { getPatient } from '@/repos/patients';
+
+/** The signed-in patient's own general record. Psychotherapy notes are excluded. */
+export const GET = route(async (req) => {
+  const user = await requireUser(req);
+  if (user.role !== 'patient' || !user.patientId) throw new HttpError(403, 'forbidden');
+  const p = await getPatient(user.patientId);
+  if (!p || p.org_id !== user.orgId) throw new HttpError(404, 'not_found');
+
+  const [appts, msgs, clinical] = await Promise.all([
+    appointments.listForExport(p.id),
+    messages.listForExport(user.id),
+    notes.listClinicalForExport(p.id),
+  ]);
+
+  await audit(user, 'export.read', 'patient', p.id);
+
+  const res = json({
+    patient: {
+      id: p.id,
+      firstName: p.first_name,
+      lastName: p.last_name,
+      dateOfBirth: p.date_of_birth,
+      email: p.email,
+      phone: p.phone,
+      mrn: p.mrn,
+    },
+    appointments: appts.map((a) => ({
+      id: a.id,
+      startsAt: a.starts_at,
+      endsAt: a.ends_at,
+      status: a.status,
+      visitReason: a.visit_reason,
+    })),
+    messages: msgs.map((m) => ({
+      id: m.id,
+      subject: m.subject,
+      body: m.body,
+      sentAt: m.created_at,
+      direction: m.sender_user_id === user.id ? 'sent' : 'received',
+    })),
+    clinicalNotes: clinical.map((n) => ({ id: n.id, createdAt: n.created_at, body: n.body })),
+  });
+  res.headers.set('cache-control', 'no-store');
+  return res;
+});
