+/** Messages a user sent or received, explicit columns, for patient export. */
+export async function listForExport(
+  userId: string,
+): Promise<Array<{ id: string; subject: string; body: string; created_at: Date; sender_user_id: string }>> {
+  return query(
+    `SELECT id, subject, body, created_at, sender_user_id
+       FROM messages
+      WHERE sender_user_id = ? OR recipient_user_id = ?
+      ORDER BY created_at DESC`,
+    [userId, userId],
+  );
+}
