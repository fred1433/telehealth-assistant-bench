+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/messages/[id]/route';
+import { query } from '@/lib/db';
+import { call, TOKENS } from './helpers';
+
+const read = (token: string | undefined, id = 'msg_001') =>
+  call(GET, { path: `/api/messages/${id}`, token, params: { id } });
+
+describe('GET /api/messages/{id}', () => {
+  it('requires authentication', async () => {
+    expect((await read(undefined)).status).toBe(401);
+  });
+
+  it('404s for other users, other roles and other practices, without marking read', async () => {
+    for (const t of [TOKENS.theo, TOKENS.rosa, TOKENS.dana, TOKENS.hal, TOKENS.june]) {
+      const res = await read(t);
+      expect(res.status).toBe(404);
+      expect(res.text).not.toContain('sleep diary');
+      expect(res.json).toEqual({ error: 'not_found' });
+    }
+    const rows = await query<{ read_at: Date | null }>('SELECT read_at FROM messages WHERE id = ?', ['msg_001']);
+    expect(rows[0].read_at).toBeNull();
+  });
+
+  it('404s for a missing message', async () => {
+    expect((await read(TOKENS.ava, 'msg_nope')).status).toBe(404);
+  });
+
+  it('returns exactly the allowed fields to the recipient and marks it read', async () => {
+    const res = await read(TOKENS.ava);
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.json).sort()).toEqual(['body', 'from', 'id', 'sentAt', 'subject']);
+    expect(res.json.from).toEqual({ name: expect.any(String) });
+    expect(res.json.id).toBe('msg_001');
+    const rows = await query<{ read_at: Date | null }>('SELECT read_at FROM messages WHERE id = ?', ['msg_001']);
+    expect(rows[0].read_at).not.toBeNull();
+  });
+});
