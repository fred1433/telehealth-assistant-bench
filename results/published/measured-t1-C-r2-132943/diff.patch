+
+function errCode(e: unknown): string {
+  const c = (e as { code?: unknown } | null)?.code;
+  return typeof c === 'string' ? c : 'unknown';
+}
+
+/** Generic notification: says only that a secure message is waiting. Never fails the request. */
+async function notifyRecipient(messageId: string, recipientId: string, email: string): Promise<void> {
+  try {
+    await sendMail({
+      to: email,
+      subject: 'You have a new secure message',
+      text: `A new secure message is waiting for you. Sign in to read it: ${env.appBaseUrl}`,
+    });
+  } catch (e) {
+    const code = errCode(e);
+    logger.error('message notify mail failed', { messageId, code });
+  }
+  let tokens: string[] = [];
+  try {
+    tokens = await listPushTokens(recipientId);
+  } catch (e) {
+    const code = errCode(e);
+    logger.error('message notify device lookup failed', { messageId, code });
+  }
+  for (const token of tokens) {
+    try {
+      await sendPush({
+        token,
+        notification: { title: 'New secure message', body: 'A new secure message is waiting. Sign in to read it.' },
+      });
+    } catch (e) {
+      const code = errCode(e);
+      logger.error('message notify push failed', { messageId, code });
+    }
+  }
+}
