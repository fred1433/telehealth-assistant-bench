+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { getUser } from '@/repos/users';
+import { getMessage, markRead } from '@/repos/messages';
+
+type Ctx = { params: Promise<{ id: string }> };
+
+/** Opens a message; only its recipient may read it (everyone else gets 404). */
+export const GET = route<Ctx>(async (req, { params }) => {
+  const user = await requireUser(req);
+  const { id } = await params;
+
+  const msg = await getMessage(id);
+  if (!msg || msg.recipient_user_id !== user.id) throw new HttpError(404, 'not found');
+
+  const sender = await getUser(msg.sender_user_id);
+  await markRead(msg.id);
+  await audit(user, 'message.read', 'message', msg.id);
+
+  return json({
+    id: msg.id,
+    subject: msg.subject,
+    body: msg.body,
+    sentAt: msg.created_at,
+    from: { name: sender?.display_name ?? '' },
+  });
+});
