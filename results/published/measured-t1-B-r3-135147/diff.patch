+/** Generic notice only: no subject, body, names or reasons. Never throws. */
+async function notifyRecipient(messageId: string, recipientId: string, email: string): Promise<void> {
+  const portal = env.appBaseUrl;
+  try {
+    await sendMail({
+      to: email,
+      subject: 'You have a new secure message',
+      text: `A new secure message is waiting for you. Please sign in to the portal to read it: ${portal}`,
+    });
+  } catch (err) {
+    logger.error('message email failed', { messageId, code: (err as { code?: string }).code });
+  }
+  let tokens: string[] = [];
+  try {
+    tokens = await listPushTokens(recipientId);
+  } catch (err) {
+    logger.error('message push token lookup failed', { messageId, code: (err as { code?: string }).code });
+  }
+  for (const token of tokens) {
+    try {
+      await sendPush({
+        token,
+        notification: { title: 'New secure message', body: 'A new secure message is waiting. Sign in to read it.' },
+      });
+    } catch (err) {
+      logger.error('message push failed', { messageId, code: (err as { code?: string }).code });
+    }
+  }
+}
