diff --git a/src/lib/scheduleCache.ts b/src/lib/scheduleCache.ts
new file mode 100644
index 0000000..6bdd772
--- /dev/null
+++ b/src/lib/scheduleCache.ts
@@ -0,0 +1,32 @@
+import { getRedis, KEY_PREFIX } from './redis';
+
+/** Short TTL; explicit invalidation handles revocations and new bookings. Well under the 15 minute cap. */
+const TTL_SECONDS = 60;
+
+// Keyed by practitioner id only (never a patient id). The cached value holds the endpoint's
+// response: ids, times, status and patient names — no visit reasons, notes or other clinical content.
+const key = (practitionerId: string) => `${KEY_PREFIX}schedule:today:${practitionerId}`;
+
+export async function getCachedSchedule(practitionerId: string, day: string): Promise<unknown | null> {
+  try {
+    const raw = await getRedis().get(key(practitionerId));
+    if (!raw) return null;
+    const parsed = JSON.parse(raw) as { day?: string };
+    return parsed.day === day ? parsed : null;
+  } catch {
+    return null; // cache failure falls back to the database
+  }
+}
+
+export async function setCachedSchedule(practitionerId: string, value: { day: string }): Promise<void> {
+  try {
+    await getRedis().set(key(practitionerId), JSON.stringify(value), 'EX', TTL_SECONDS);
+  } catch {
+    /* best effort */
+  }
+}
+
+/** Must succeed: callers rely on it for revocation to take effect immediately. */
+export async function invalidateSchedule(practitionerId: string): Promise<void> {
+  await getRedis().del(key(practitionerId));
+}
