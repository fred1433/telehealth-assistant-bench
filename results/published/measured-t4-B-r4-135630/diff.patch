diff --git a/src/lib/scheduleCache.ts b/src/lib/scheduleCache.ts
new file mode 100644
index 0000000..0e11f63
--- /dev/null
+++ b/src/lib/scheduleCache.ts
@@ -0,0 +1,39 @@
+import { getRedis, KEY_PREFIX } from './redis';
+import { todayUtc } from './time';
+import { logger } from './logger';
+
+/** Short on purpose: the cached body holds patient names. Revocation also deletes the key. */
+const TTL_SECONDS = 60;
+
+function key(practitionerId: string, day: string): string {
+  return `${KEY_PREFIX}schedule:today:${practitionerId}:${day}`;
+}
+
+function code(err: unknown): string | undefined {
+  return (err as { code?: string }).code;
+}
+
+export async function getCachedDay(practitionerId: string, day: string): Promise<string | null> {
+  try {
+    return await getRedis().get(key(practitionerId, day));
+  } catch (err) {
+    logger.warn('schedule cache read failed', { practitionerId, code: code(err) });
+    return null;
+  }
+}
+
+export async function setCachedDay(practitionerId: string, day: string, body: string): Promise<void> {
+  try {
+    await getRedis().set(key(practitionerId, day), body, 'EX', TTL_SECONDS);
+  } catch (err) {
+    logger.warn('schedule cache write failed', { practitionerId, code: code(err) });
+  }
+}
+
+export async function invalidateDay(practitionerId: string): Promise<void> {
+  try {
+    await getRedis().del(key(practitionerId, todayUtc()));
+  } catch (err) {
+    logger.warn('schedule cache invalidate failed', { practitionerId, code: code(err) });
+  }
+}
diff --git a/tests/scheduleCache.test.ts b/tests/scheduleCache.test.ts
new file mode 100644
index 0000000..6049dee
--- /dev/null
+++ b/tests/scheduleCache.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/practitioner/schedule/today/route';
+import { POST as revoke } from '@/app/api/admin/care-team/revoke/route';
+import { getRedis, KEY_PREFIX } from '@/lib/redis';
+import { call, TOKENS } from './helpers';
+
+describe('schedule day-view cache', () => {
+  it('writes only short-lived, patient-id-free keys without clinical content', async () => {
+    const res = await call(GET, { token: TOKENS.rosa });
+    expect(res.status).toBe(200);
+    const redis = getRedis();
+    const keys = await redis.keys(`${KEY_PREFIX}schedule:*`);
+    expect(keys.length).toBeGreaterThan(0);
+    for (const k of keys) {
+      expect(k).not.toMatch(/pt_/);
+      const ttl = await redis.ttl(k);
+      expect(ttl).toBeGreaterThan(0);
+      expect(ttl).toBeLessThanOrEqual(900);
+      const v = (await redis.get(k)) ?? '';
+      expect(v).not.toContain('Follow-up on sleep');
+      expect(v).not.toContain('Bring sleep diary');
+    }
+  });
+
+  it('serves the same body from cache and keeps practitioners separate', async () => {
+    const a = await call(GET, { token: TOKENS.rosa });
+    const b = await call(GET, { token: TOKENS.rosa });
+    expect(b.json).toEqual(a.json);
+    const m = await call(GET, { token: TOKENS.malik });
+    expect(m.json.appointments.map((x: { id: string }) => x.id)).toEqual(['apt_003']);
+  });
+
+  it('drops a patient from the day view right after revocation', async () => {
+    await call(GET, { token: TOKENS.rosa }); // warm cache
+    const rev = await call(revoke, {
+      method: 'POST',
+      token: TOKENS.dana,
+      body: { practitionerId: 'pr_rosa', patientId: (await call(GET, { token: TOKENS.rosa })).json.appointments[0].patient.id },
+    });
+    expect(rev.status).toBe(200);
+    const after = await call(GET, { token: TOKENS.rosa });
+    expect(after.json.appointments.map((x: { id: string }) => x.id)).toEqual(['apt_002']);
+  });
+});
