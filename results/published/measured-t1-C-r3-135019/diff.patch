+
+function failureCode(err: unknown): string {
+  const c = (err as { code?: unknown } | null)?.code;
+  return typeof c === 'string' ? c : 'unknown';
+}
+
+/** Generic notification: no subject, body, names or reason for care. Never throws. */
+async function notifyRecipient(messageId: string, recipientId: string, email: string): Promise<void> {
+  try {
+    await sendMail({
+      to: email,
+      subject: 'You have a new secure message',
+      text: `A new secure message is waiting for you. Sign in to the portal to read it: ${env.appBaseUrl}`,
+    });
+  } catch (e) {
+    const code = failureCode(e);
+    logger.error('message notification mail failed', { messageId, recipientId, code });
+  }
+  let tokens: string[] = [];
+  try {
+    tokens = await listPushTokens(recipientId);
+  } catch (e) {
+    const code = failureCode(e);
+    logger.error('message notification device lookup failed', { messageId, recipientId, code });
+  }
+  for (const token of tokens) {
+    try {
+      await sendPush({
+        token,
+        notification: { title: 'New secure message', body: 'A new secure message is waiting. Sign in to read it.' },
+      });
+    } catch (e) {
+      const code = failureCode(e);
+      logger.error('message notification push failed', { messageId, recipientId, code });
+    }
+  }
+}
