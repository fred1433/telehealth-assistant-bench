+import { requireUser } from '@/lib/auth';
+import { json, route, HttpError } from '@/lib/http';
+import { audit } from '@/lib/audit';
+import { getForRecipient, markRead } from '@/repos/messages';
+
+type Ctx = { params: Promise<{ id: string }> };
+
+/** Opens a message for its recipient and marks it read. Everyone else gets 404. */
+export const GET = route<Ctx>(async (req, { params }) => {
+  const user = await requireUser(req);
+  const { id } = await params;
+  const msg = await getForRecipient(id, user.id, user.orgId);
+  if (!msg) throw new HttpError(404, 'not_found');
+
+  await markRead(msg.id);
+  await audit(user, 'message.read', 'message', msg.id);
+  return json({
+    id: msg.id,
+    subject: msg.subject,
+    body: msg.body,
+    sentAt: msg.created_at,
+    from: { name: msg.sender_name },
+  });
+});
