+describe('GET /api/messages/{id}', () => {
+  const open = async (token: string | undefined, id = 'msg_001') => {
+    const { GET: GET_ONE } = await import('@/app/api/messages/[id]/route');
+    return call(GET_ONE, { token, path: `/api/messages/${id}`, params: { id } });
+  };
+
+  it('requires authentication', async () => {
+    expect((await open(undefined)).status).toBe(401);
+  });
+
+  it('hides the message from non-recipients, other roles, admins and other practices', async () => {
+    for (const t of [TOKENS.rosa, TOKENS.theo, TOKENS.dana, TOKENS.hal, TOKENS.june]) {
+      const res = await open(t);
+      expect(res.status).toBe(404);
+      expect(res.text).not.toContain('sleep diary');
+    }
+    expect((await open(TOKENS.ava, 'msg_nope')).status).toBe(404);
+  });
+
+  it('returns exactly the allowed fields to the recipient and marks it read', async () => {
+    const res = await open(TOKENS.ava);
+    expect(res.status).toBe(200);
+    expect(Object.keys(res.json).sort()).toEqual(['body', 'from', 'id', 'sentAt', 'subject']);
+    expect(Object.keys(res.json.from)).toEqual(['name']);
+    expect(res.json.id).toBe('msg_001');
+    const inbox = await call(GET, { token: TOKENS.ava });
+    expect(inbox.json.messages.find((m: any) => m.id === 'msg_001').read).toBe(true);
+  });
+});
