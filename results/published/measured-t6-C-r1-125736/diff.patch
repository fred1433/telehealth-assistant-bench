+++ b/tests/patient-search.test.ts
@@ -0,0 +1,50 @@
+import { describe, expect, it, vi } from 'vitest';
+import { POST } from '@/app/api/patients/search/route';
+import { call, TOKENS } from './helpers';
+
+const search = (token: string | undefined, q: unknown) =>
+  call(POST, { method: 'POST', path: '/api/patients/search', token, body: { q } });
+
+describe('POST /api/patients/search', () => {
+  it('finds own-practice patients case-insensitively, anywhere in the name, with only the listed fields', async () => {
+    const all = await search(TOKENS.rosa, 'a');
+    expect(all.status).toBe(400);
+    const res = await search(TOKENS.rosa, 'VA');
+    expect(res.status).toBe(200);
+    expect(res.json.results.map((r: any) => r.id)).toContain('pt_ava');
+    for (const r of res.json.results) expect(Object.keys(r).sort()).toEqual(['dateOfBirth', 'firstName', 'id', 'lastName']);
+    expect(res.text).not.toMatch(/mrn|email|phone|reason/i);
+  });
+
+  it('does not treat LIKE wildcards as wildcards', async () => {
+    const res = await search(TOKENS.rosa, '%%');
+    expect(res.status).toBe(200);
+    expect(res.json.results).toEqual([]);
+  });
+
+  it('does not return patients of another practice', async () => {
+    const own = await search(TOKENS.hal, 'ju');
+    expect(own.json.results.map((r: any) => r.id)).toEqual(['pt_june']);
+    const cross = await search(TOKENS.hal, 'ava');
+    expect(cross.json.results).toEqual([]);
+    const juneFromRosa = await search(TOKENS.rosa, 'june');
+    expect(juneFromRosa.json.results).toEqual([]);
+  });
+
+  it('refuses other roles and anonymous callers', async () => {
+    expect((await search(TOKENS.ava, 'ava')).status).toBe(403);
+    expect((await search(TOKENS.dana, 'ava')).status).toBe(403);
+    expect((await search(undefined, 'ava')).status).toBe(401);
+  });
+
+  it('is not reachable via GET/query string and logs nothing of the search', async () => {
+    expect((await import('@/app/api/patients/search/route') as any).GET).toBeUndefined();
+    const out = vi.spyOn(process.stdout, 'write');
+    const err = vi.spyOn(process.stderr, 'write');
+    await search(TOKENS.rosa, 'zzzq');
+    const written = [...out.mock.calls, ...err.mock.calls].map((c) => String(c[0])).join('');
+    expect(written).not.toContain('zzzq');
+    out.mockRestore();
+    err.mockRestore();
+  });
+});
