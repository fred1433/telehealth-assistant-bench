diff --git a/tests/export.test.ts b/tests/export.test.ts
new file mode 100644
index 0000000..8405f69
--- /dev/null
+++ b/tests/export.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it } from 'vitest';
+import { GET } from '@/app/api/me/export/route';
+import { call, TOKENS } from './helpers';
+
+describe('GET /api/me/export', () => {
+  it('returns the patient own general record', async () => {
+    const res = await call(GET, { token: TOKENS.ava });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_ava');
+    expect(Object.keys(res.json.patient).sort()).toEqual(
+      ['dateOfBirth', 'email', 'firstName', 'id', 'lastName', 'mrn', 'phone'],
+    );
+    expect(res.json.appointments.length).toBeGreaterThan(0);
+    expect(Object.keys(res.json.appointments[0]).sort()).toEqual(['endsAt', 'id', 'startsAt', 'status', 'visitReason']);
+    const dirs = Object.fromEntries(res.json.messages.map((m: any) => [m.id, m.direction]));
+    expect(dirs).toEqual({ msg_001: 'received', msg_002: 'sent' });
+    expect(res.json.clinicalNotes.map((n: any) => n.id).sort()).toEqual(['cn_001', 'cn_002']);
+  });
+
+  it('excludes psychotherapy notes, appointment notes and other patients data', async () => {
+    const res = await call(GET, { token: TOKENS.ava });
+    expect(res.text).not.toContain('pn_001');
+    expect(res.text).not.toContain('transference');
+    expect(res.text).not.toContain('pt_theo');
+    expect(res.text).not.toContain('shame narrative');
+    expect(res.text).not.toContain('60 days abstinent');
+    expect(res.text).not.toContain('reason_for_care');
+  });
+
+  it('scopes to the caller (Theo gets only his own)', async () => {
+    const res = await call(GET, { token: TOKENS.theo });
+    expect(res.status).toBe(200);
+    expect(res.json.patient.id).toBe('pt_theo');
+    expect(res.json.clinicalNotes.map((n: any) => n.id)).toEqual(['cn_003']);
+    expect(res.json.messages).toEqual([]);
+  });
+
+  it('refuses other roles and unauthenticated callers', async () => {
+    for (const t of [TOKENS.rosa, TOKENS.dana, TOKENS.hal]) {
+      expect((await call(GET, { token: t })).status).toBe(403);
+    }
+    expect((await call(GET)).status).toBe(401);
+  });
+});
