+const NOTICE = 'You have a new secure message. Sign in to the portal to read it.';
+
+/** Generic notification (no names, subject or body). Failures never escape; only id and code are logged. */
+async function notifyRecipient(messageId: string, recipientId: string, email: string): Promise<void> {
+  try {
+    await sendMail({ to: email, subject: 'New secure message', text: `${NOTICE}\n\n${env.appBaseUrl}` });
+  } catch (err) {
+    logger.error('message mail failed', { messageId, code: (err as { code?: string }).code });
+  }
+  let tokens: string[] = [];
+  try {
+    tokens = await listPushTokens(recipientId);
+  } catch (err) {
+    logger.error('message push lookup failed', { messageId, code: (err as { code?: string }).code });
+  }
+  for (const token of tokens) {
+    try {
+      await sendPush({ token, notification: { title: 'New secure message', body: 'Sign in to the portal to read it.' } });
+    } catch (err) {
+      logger.error('message push failed', { messageId, code: (err as { code?: string }).code });
+    }
+  }
+}
